# MoodBite environment template.
# Copy this file to .env for local development. Never commit .env.

# Runtime environment.
ASPNETCORE_ENVIRONMENT=Development

# Kestrel URL when running without launchSettings.json.
ASPNETCORE_URLS=http://localhost:5298

# Host filtering. Use explicit production host names in deployed environments.
ALLOWED_HOSTS=localhost;127.0.0.1

# SQL Server connection string. Use a secret store or hosting environment variable in production.
MOODBITE_DB_CONNECTION_STRING=Server=(localdb)\mssqllocaldb;Database=MoodBiteDb;Trusted_Connection=True;MultipleActiveResultSets=true
# ConnectionStrings__DefaultConnection=Server=tcp:your-sql-host,1433;Initial Catalog=MoodBite;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False

# Gemini. Leave blank for offline development/demo fallback behavior.
GEMINI_API_KEY=
GEMINI_HTTP_TIMEOUT_SECONDS=120

# OpenFoodFacts scanner client.
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org/
OPENFOODFACTS_USER_AGENT=MoodBite/1.0 (contact@example.com)
OPENFOODFACTS_TIMEOUT_SECONDS=15

# Development-only demo seed. Only honored when ASPNETCORE_ENVIRONMENT=Development.
MOODBITE_SEED_DEMO_DATA=false

# Email provider. Use placeholders only here; configure real values in the hosting platform.
# Supported provider: Smtp
EMAIL_PROVIDER=
EMAIL_FROM=no-reply@your-domain.example
EMAIL_FROM_NAME=MoodBite
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true

# Rate limiting. Defaults are intentionally moderate for normal demos.
RATE_LIMIT_AUTH_PERMIT_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AI_PERMIT_LIMIT=20
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_SCANNER_PERMIT_LIMIT=30
RATE_LIMIT_SCANNER_WINDOW_SECONDS=60

# Logging.
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning