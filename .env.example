# MoodBite environment template.
# Copy this file to .env for local development. Never commit .env.

# Used by ASP.NET Core to select the runtime environment and environment-specific settings.
ASPNETCORE_ENVIRONMENT=Development

# Used by Kestrel when running without launchSettings.json.
ASPNETCORE_URLS=http://localhost:5298

# Used by ASP.NET Core host filtering. Use production host names in deployed environments.
ALLOWED_HOSTS=localhost;127.0.0.1

# Used by ApplicationDbContext in Program.cs for EF Core SQL Server access.
MOODBITE_DB_CONNECTION_STRING=Server=(localdb)\mssqllocaldb;Database=MoodBiteDb;Trusted_Connection=True;MultipleActiveResultSets=true

# Optional native ASP.NET Core equivalent for the database connection string.
# Leave this commented when MOODBITE_DB_CONNECTION_STRING is set.
# ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=MoodBiteDb;Trusted_Connection=True;MultipleActiveResultSets=true

# Used by GeminiService through configuration key Gemini:ApiKey.
# Leave blank for offline demos; AI features will use fallback behavior where available.
GEMINI_API_KEY=

# Used by the typed HttpClient registered for GeminiService.
GEMINI_HTTP_TIMEOUT_SECONDS=120

# Used by ScannerController through the named OpenFoodFacts HttpClient.
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org/

# Used by OpenFoodFacts requests. Replace the contact with a monitored project email.
OPENFOODFACTS_USER_AGENT=MoodBite/1.0 (contact@example.com)

# Used by the named OpenFoodFacts HttpClient request timeout.
OPENFOODFACTS_TIMEOUT_SECONDS=15

# Controls prototype/demo account seeding in Data/DbSeeder.cs.
# Only honored in ASPNETCORE_ENVIRONMENT=Development. Keep false outside disposable local demos.
MOODBITE_SEED_DEMO_DATA=false

# Email delivery is not implemented in this MVP. In Development, password reset and
# patient invitation flows show copyable links. In Production, configure a real
# email sender before enabling live clinic onboarding.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@your-domain.example

# Used by ASP.NET Core logging configuration.
LOG_LEVEL_DEFAULT=Information

# Used by ASP.NET Core logging configuration for Microsoft.AspNetCore categories.
LOG_LEVEL_ASPNETCORE=Warning
