@model ClinicSettingsViewModel
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("clinic.nav.settings");
}

@if (Model.ClinicDataUnavailable || !Model.HasClinicContext)
{
    <div class="card-glass p-5 text-center" style="border-radius:var(--radius-lg);max-width:760px;margin:0 auto">
        <div style="width:70px;height:70px;border-radius:var(--radius-lg);background:var(--primary-50);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;color:var(--primary)">
            <i data-lucide="building-2" style="width:34px;height:34px"></i>
        </div>
        <h3 style="font-weight:900;color:var(--text-primary);font-size:1.25rem">@T.Get("clinic.emptyTitle")</h3>
        <p style="color:var(--text-secondary);max-width:560px;margin:8px auto 0">
            @(Model.ClinicDataUnavailable ? T.Get("clinic.dataUnavailable") : T.Get("clinic.settings.emptyBody"))
        </p>
    </div>
}
else
{
    <form asp-action="Update" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ClinicId" />
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card-glass p-4" style="border-radius:var(--radius-lg)">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                        <div>
                            <h4 style="font-weight:900;margin:0">@T.Get("clinic.settings.profile")</h4>
                            <p style="color:var(--text-secondary);margin:4px 0 0">@T.Get("clinic.settings.profileBody")</p>
                        </div>
                        <span class="badge-custom @(Model.IsActive ? "badge-primary" : "badge-neutral")">
                            @(Model.IsActive ? T.Get("common.active") : T.Get("common.inactive"))
                        </span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">@T.Get("clinic.field.name")</label>
                            <input asp-for="Name" class="form-control" maxlength="160" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LegalName" class="form-label">@T.Get("clinic.field.legalName")</label>
                            <input asp-for="LegalName" class="form-control" maxlength="160" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">@T.Get("auth.email")</label>
                            <input asp-for="Email" type="email" class="form-control" maxlength="256" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">@T.Get("clinic.field.phone")</label>
                            <input asp-for="Phone" class="form-control" maxlength="40" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Country" class="form-label">@T.Get("clinic.field.country")</label>
                            <input asp-for="Country" class="form-control" maxlength="120" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label">@T.Get("clinic.field.city")</label>
                            <input asp-for="City" class="form-control" maxlength="120" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label">@T.Get("clinic.field.address")</label>
                            <input asp-for="Address" class="form-control" maxlength="300" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card-glass p-4" style="border-radius:var(--radius-lg)">
                    <h5 style="font-weight:900;margin-bottom:14px">@T.Get("clinic.settings.identity")</h5>
                    <div class="mb-3">
                        <label class="form-label">@T.Get("clinic.field.slug")</label>
                        <input value="@Model.Slug" class="form-control" disabled />
                    </div>
                    @if (Model.CanEditActiveStatus)
                    {
                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">@T.Get("clinic.field.active")</label>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="IsActive" />
                        <p style="font-size:.85rem;color:var(--text-secondary)">@T.Get("clinic.settings.activeAdminOnly")</p>
                    }
                    <button type="submit" class="btn-primary-custom w-100">
                        <i data-lucide="save"></i>@T.Get("common.save")
                    </button>
                </div>
            </div>
        </div>
    </form>
}
