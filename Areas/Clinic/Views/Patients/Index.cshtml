@model ClinicPatientsIndexViewModel
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("clinic.patientRoster");

    string StatusLabel(string status) => status switch
    {
        "active" => T.Get("common.active"),
        "pending" => T.Get("common.pending"),
        "archived" => T.Get("clinic.status.archived"),
        "discharged" => T.Get("clinic.status.discharged"),
        "accepted" => T.Get("common.accepted"),
        "revoked" => T.Get("clinic.status.revoked"),
        "expired" => T.Get("clinic.status.expired"),
        _ => status
    };

    string StatusBadge(string status) => status switch
    {
        "active" or "accepted" => "badge-primary",
        "pending" => "badge-neutral",
        "archived" or "discharged" or "revoked" or "expired" => "badge-neutral",
        _ => "badge-neutral"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.ClinicDataUnavailable || !Model.HasClinicContext)
{
    <div class="card-glass p-5 text-center" style="border-radius:var(--radius-lg);max-width:760px;margin:0 auto">
        <div style="width:70px;height:70px;border-radius:var(--radius-lg);background:var(--primary-50);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;color:var(--primary)">
            <i data-lucide="users" style="width:34px;height:34px"></i>
        </div>
        <h3 style="font-weight:900;color:var(--text-primary);font-size:1.25rem">@T.Get("clinic.emptyTitle")</h3>
        <p style="color:var(--text-secondary);max-width:560px;margin:8px auto 0">
            @(Model.ClinicDataUnavailable ? T.Get("clinic.dataUnavailable") : T.Get("clinic.patients.emptyBody"))
        </p>
    </div>
}
else
{
    <section style="background:linear-gradient(135deg,#064e3b 0%,#047857 55%,#0d9488 100%);border-radius:var(--radius-lg);padding:22px;margin-bottom:22px;box-shadow:var(--shadow-md)">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <div style="color:rgba(255,255,255,.72);font-weight:800;font-size:.78rem;text-transform:uppercase">@Model.ClinicName</div>
                <h2 style="color:white;font-weight:900;margin:4px 0;font-size:clamp(1.4rem,3vw,2rem)">@T.Get("clinic.patientRoster")</h2>
                <p style="color:rgba(255,255,255,.72);margin:0;max-width:720px">@T.Get("clinic.patients.subtitle")</p>
            </div>
            <div style="width:56px;height:56px;border-radius:var(--radius-lg);background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;color:white">
                <i data-lucide="users-round" style="width:30px;height:30px"></i>
            </div>
        </div>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card p-3" style="border-radius:var(--radius-lg)">
                <div style="font-size:1.65rem;font-weight:900;color:var(--primary)">@Model.ActivePatients</div>
                <div style="color:var(--text-secondary);font-weight:700;font-size:.84rem">@T.Get("clinic.activePatients")</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card p-3" style="border-radius:var(--radius-lg)">
                <div style="font-size:1.65rem;font-weight:900;color:var(--icon-amber)">@Model.PendingPatients</div>
                <div style="color:var(--text-secondary);font-weight:700;font-size:.84rem">@T.Get("common.pending")</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card p-3" style="border-radius:var(--radius-lg)">
                <div style="font-size:1.65rem;font-weight:900;color:var(--icon-blue)">@Model.PendingInvitations</div>
                <div style="color:var(--text-secondary);font-weight:700;font-size:.84rem">@T.Get("clinic.invitations.pending")</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card p-3" style="border-radius:var(--radius-lg)">
                <div style="font-size:1.65rem;font-weight:900;color:var(--icon-purple)">@Model.TotalPatients</div>
                <div style="color:var(--text-secondary);font-weight:700;font-size:.84rem">@T.Get("clinic.patients.total")</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.LastInvitationLink))
    {
        <div class="card-glass p-4 mb-4" style="border-radius:var(--radius-lg);border-color:var(--primary-200)">
            <h5 style="font-weight:900;margin-bottom:10px">@T.Get("clinic.invitations.shareLink")</h5>
            <p style="color:var(--text-secondary);margin-bottom:12px">@T.Get("clinic.invitations.shareLinkBody")</p>
            <input class="form-control" value="@Model.LastInvitationLink" readonly />
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                <h5 style="font-weight:900;margin-bottom:14px">@T.Get("clinic.patients.searchTitle")</h5>
                <form asp-area="Clinic" asp-controller="Patients" asp-action="Index" method="get" class="row g-3">
                    <input type="hidden" name="clinicId" value="@Model.ClinicId" />
                    <div class="col-md-5">
                        <label class="form-label">@T.Get("common.search")</label>
                        <input name="q" value="@Model.Query" class="form-control" placeholder="@T.Get("clinic.patients.searchPlaceholder")" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@T.Get("clinic.patientStatus")</label>
                        <select name="status" class="form-select">
                            <option value="all" selected="@(Model.StatusFilter == "all")">@T.Get("common.all")</option>
                            <option value="active" selected="@(Model.StatusFilter == "active")">@T.Get("common.active")</option>
                            <option value="pending" selected="@(Model.StatusFilter == "pending")">@T.Get("common.pending")</option>
                            <option value="archived" selected="@(Model.StatusFilter == "archived")">@T.Get("clinic.status.archived")</option>
                            <option value="discharged" selected="@(Model.StatusFilter == "discharged")">@T.Get("clinic.status.discharged")</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@T.Get("clinic.patients.consent")</label>
                        <select name="consent" class="form-select">
                            <option value="all" selected="@(Model.ConsentFilter == "all")">@T.Get("common.all")</option>
                            <option value="granted" selected="@(Model.ConsentFilter == "granted")">@T.Get("clinic.patients.consentGranted")</option>
                            <option value="missing" selected="@(Model.ConsentFilter == "missing")">@T.Get("clinic.patients.consentMissing")</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn-primary-custom w-100" style="padding-inline:12px">
                            <i data-lucide="search"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                <h5 style="font-weight:900;margin-bottom:14px">@T.Get("clinic.patients.addPatient")</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <form asp-area="Clinic" asp-controller="Patients" asp-action="Invite" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ClinicId" value="@Model.ClinicId" />
                            <input name="Email" type="email" class="form-control" placeholder="@T.Get("clinic.patients.inviteEmail")" required />
                            <button type="submit" class="btn-primary-custom" style="white-space:nowrap">
                                <i data-lucide="mail-plus"></i>@T.Get("clinic.patients.invite")
                            </button>
                        </form>
                    </div>
                    <div class="col-12">
                        <form asp-area="Clinic" asp-controller="Patients" asp-action="LinkExisting" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ClinicId" value="@Model.ClinicId" />
                            <input name="Email" type="email" class="form-control" placeholder="@T.Get("clinic.patients.linkEmail")" required />
                            <button type="submit" class="btn-secondary-custom" style="white-space:nowrap">
                                <i data-lucide="link"></i>@T.Get("clinic.patients.linkExisting")
                            </button>
                        </form>
                    </div>
                </div>
                <p style="color:var(--text-secondary);font-size:.82rem;margin:14px 0 0">@T.Get("clinic.patients.noAutoCreate")</p>
            </div>
        </div>
    </div>

    <div class="card-glass p-4 mb-4" style="border-radius:var(--radius-lg)">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 style="font-weight:900;margin:0">@T.Get("clinic.patients")</h4>
            <span class="badge-custom badge-primary">@Model.Patients.Count</span>
        </div>

        @if (Model.Patients.Count == 0)
        {
            <div class="text-center py-5">
                <div style="font-size:2.4rem;color:var(--primary);margin-bottom:10px"><i data-lucide="users"></i></div>
                <h6 style="font-weight:800">@T.Get("clinic.patients.noPatients")</h6>
                <p style="color:var(--text-secondary);margin:0">@T.Get("clinic.patients.noPatientsBody")</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>@T.Get("clinic.patient")</th>
                            <th>@T.Get("clinic.patientStatus")</th>
                            <th>@T.Get("clinic.patients.profile")</th>
                            <th>@T.Get("clinic.patients.assignedTo")</th>
                            <th>@T.Get("clinic.patients.linkedAt")</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var patient in Model.Patients)
                    {
                        <tr>
                            <td>
                                <div style="font-weight:900">@patient.FullName</div>
                                <div style="font-size:.82rem;color:var(--text-secondary)">@patient.Email</div>
                            </td>
                            <td>
                                <span class="badge-custom @StatusBadge(patient.Status)">@StatusLabel(patient.Status)</span>
                                <div style="font-size:.74rem;color:var(--text-secondary);margin-top:6px">
                                    @(patient.ConsentGranted ? T.Get("clinic.patients.consentGranted") : T.Get("clinic.patients.consentMissing"))
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(patient.DietSlug) || !string.IsNullOrWhiteSpace(patient.Goal))
                                {
                                    <div style="font-size:.84rem;color:var(--text-primary);font-weight:700">@patient.DietSlug</div>
                                    <div style="font-size:.78rem;color:var(--text-secondary)">
                                        @patient.Goal
                                        @if (patient.Weight.HasValue)
                                        {
                                            <span> - @patient.Weight.Value.ToString("0.#") @T.Get("common.kg")</span>
                                        }
                                        @if (patient.CalorieTarget.HasValue)
                                        {
                                            <span> - @patient.CalorieTarget.Value.ToString("0") @T.Get("common.calories")</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted)">@T.Get("clinic.patients.noProfile")</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(patient.PrimaryDietitianName) ? T.Get("clinic.patients.unassigned") : patient.PrimaryDietitianName)</td>
                            <td style="color:var(--text-secondary);font-size:.84rem">@patient.LinkedAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card-glass p-4" style="border-radius:var(--radius-lg)">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 style="font-weight:900;margin:0">@T.Get("clinic.invitations")</h4>
            <span class="badge-custom badge-neutral">@Model.Invitations.Count</span>
        </div>
        @if (Model.Invitations.Count == 0)
        {
            <p style="color:var(--text-secondary);margin:0">@T.Get("clinic.invitations.none")</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>@T.Get("auth.email")</th>
                            <th>@T.Get("clinic.field.status")</th>
                            <th>@T.Get("clinic.invitations.invitedBy")</th>
                            <th>@T.Get("clinic.invitations.expiresAt")</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var invitation in Model.Invitations)
                    {
                        var status = invitation.IsExpired ? "expired" : invitation.Status;
                        <tr>
                            <td style="font-weight:800">@invitation.Email</td>
                            <td><span class="badge-custom @StatusBadge(status)">@StatusLabel(status)</span></td>
                            <td>@invitation.InvitedByName</td>
                            <td style="color:var(--text-secondary);font-size:.84rem">@invitation.ExpiresAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
