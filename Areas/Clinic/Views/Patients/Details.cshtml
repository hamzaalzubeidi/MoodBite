    <div class="tab-pane fade" id="progress-pane" role="tabpanel" aria-labelledby="progress-tab" tabindex="0">
        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                        <div>
                            <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.weightProgress")</h3>
                            <p class="patient-section-subtitle">@T.Get(Model.WeightTrendKey)</p>
                        </div>
                        <span class="badge-custom badge-primary">@Model.WeightHistory.Count @T.Get("clinic.patientDashboard.entries")</span>
                    </div>
                    @if (Model.WeightHistory.Count < 2)
                    {
                        <div class="patient-empty">
                            <i data-lucide="line-chart"></i>
                            <div>@T.Get("clinic.patientDashboard.noWeightLogs")</div>
                        </div>
                    }
                    else
                    {
                        <div class="patient-chart-frame"><canvas id="clinicWeightChart"></canvas></div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                    <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.latestWeightEntries")</h3>
                    @if (Model.WeightHistory.Count == 0)
                    {
                        <div class="patient-empty mt-3">
                            <i data-lucide="scale"></i>
                            <div>@T.Get("clinic.patientDashboard.noWeightLogsShort")</div>
                        </div>
                    }
                    else
                    {
                        <div class="patient-compact-list mt-3">
                            @foreach (var log in Model.WeightHistory.Take(6))
                            {
                                <div class="patient-list-row">
                                    <div class="d-flex justify-content-between gap-2">
                                        <strong>@log.Date.ToString("yyyy-MM-dd")</strong>
                                        <span style="font-weight:900;color:var(--primary)">@FormatKg(log.Weight)</span>
                                    </div>
                                    <div style="color:@ChangeColor(log.ChangeFromPrevious);font-size:.8rem;font-weight:800;margin-top:4px">@SignedKg(log.ChangeFromPrevious)</div>
                                    @if (!string.IsNullOrWhiteSpace(log.Note))
                                    {
                                        <div style="color:var(--text-secondary);font-size:.78rem;margin-top:4px">@log.Note</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                    <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.bodyProgress")</h3>
                    @if (Model.ProgressEntries.Count == 0)
                    {
                        <div class="patient-empty mt-3">
                            <i data-lucide="ruler"></i>
                            <div>@T.Get("clinic.patientDashboard.noProgress")</div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@T.Get("clinic.patientDashboard.date")</th>
                                        <th>@T.Get("profile.weight")</th>
                                        <th>@T.Get("clinic.patientDashboard.waist")</th>
                                        <th>@T.Get("clinic.patientDashboard.measurements")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var entry in Model.ProgressEntries)
                                {
                                    <tr>
                                        <td style="font-weight:800">@entry.Date.ToString("yyyy-MM-dd")</td>
                                        <td>@FormatKg(entry.Weight)</td>
                                        <td>@FormatCm(entry.Waist)</td>
                                        <td style="font-size:.82rem;color:var(--text-secondary)">
                                            @T.Get("clinic.patientDashboard.hips"): @FormatCm(entry.Hips) -
                                            @T.Get("clinic.patientDashboard.chest"): @FormatCm(entry.Chest) -
                                            @T.Get("clinic.patientDashboard.arms"): @FormatCm(entry.Arms)
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                    <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.progressPhotos")</h3>
                    @{
                        var photos = Model.ProgressEntries.Where(p => !string.IsNullOrWhiteSpace(p.PhotoPath)).ToList();
                    }
                    @if (photos.Count == 0)
                    {
                        <div class="patient-empty mt-3">
                            <i data-lucide="image"></i>
                            <div>@T.Get("clinic.patientDashboard.noPhotos")</div>
                        </div>
                    }
                    else
                    {
                        <div class="patient-photo-grid mt-3">
                            @foreach (var photo in photos)
                            {
                                <div>
                                    <div class="patient-photo">
                                        <img src="@photo.PhotoPath" alt="@T.Get("clinic.patientDashboard.progressPhotoAlt")" loading="lazy" />
                                    </div>
                                    <div style="font-size:.76rem;color:var(--text-secondary);font-weight:800;margin-top:6px">@photo.Date.ToString("yyyy-MM-dd")</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="nutrition-pane" role="tabpanel" aria-labelledby="nutrition-tab" tabindex="0">
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-6">
                <div class="patient-metric">
                    <span class="patient-metric-icon"><i data-lucide="calendar-check"></i></span>
                    <div class="patient-metric-value">@Model.RecentMealLogCount</div>
                    <div class="patient-metric-label">@T.Get("clinic.patientDashboard.recentMealLogs")</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="patient-metric">
                    <span class="patient-metric-icon"><i data-lucide="scan-line"></i></span>
                    <div class="patient-metric-value">@Model.RecentFoodScanCount</div>
                    <div class="patient-metric-label">@T.Get("clinic.patientDashboard.recentFoodScans")</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="patient-metric">
                    <span class="patient-metric-icon"><i data-lucide="flame"></i></span>
                    <div class="patient-metric-value">@FormatCalories(Model.RecentMealLogCount > 0 ? Model.RecentAvgCalories : null)</div>
                    <div class="patient-metric-label">@T.Get("dashboard.avgCalories")</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="patient-metric">
                    <span class="patient-metric-icon"><i data-lucide="beef"></i></span>
                    <div class="patient-metric-value">@(Model.RecentMealLogCount > 0 ? $"{Model.RecentAvgProtein:0.#} {T.Get("common.gram")}" : empty)</div>
                    <div class="patient-metric-label">@T.Get("dashboard.protein")</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                    <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.mealLogs")</h3>
                    @if (Model.MealLogs.Count == 0)
                    {
                        <div class="patient-empty mt-3">
                            <i data-lucide="utensils"></i>
                            <div>@T.Get("clinic.patientDashboard.noMealLogs")</div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@T.Get("clinic.patientDashboard.date")</th>
                                        <th>@T.Get("dashboard.calories")</th>
                                        <th>@T.Get("clinic.patientDashboard.macros")</th>
                                        <th>@T.Get("dashboard.adherence")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var log in Model.MealLogs.Take(8))
                                {
                                    <tr>
                                        <td style="font-weight:800">@log.Date.ToString("yyyy-MM-dd")</td>
                                        <td>@log.CaloriesConsumed.ToString("0") @T.Get("common.calories")</td>
                                        <td style="font-size:.82rem;color:var(--text-secondary)">
                                            @T.Get("dashboard.protein") @log.Protein.ToString("0.#")g -
                                            @T.Get("dashboard.carbs") @log.Carbs.ToString("0.#")g -
                                            @T.Get("dashboard.fats") @log.Fats.ToString("0.#")g
                                        </td>
                                        <td>
                                            <span class="badge-custom @(log.Adherent ? "badge-primary" : "badge-neutral")">
                                                @(log.Adherent ? T.Get("common.yes") : T.Get("common.no"))
                                            </span>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                    <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.foodScans")</h3>
                    @if (Model.FoodScans.Count == 0)
                    {
                        <div class="patient-empty mt-3">
                            <i data-lucide="scan-search"></i>
                            <div>@T.Get("clinic.patientDashboard.noFoodScans")</div>
                        </div>
                    }
                    else
                    {
                        <div class="patient-compact-list mt-3">
                            @foreach (var scan in Model.FoodScans)
                            {
                                <div class="patient-list-row">
                                    <div class="d-flex justify-content-between gap-3">
                                        <strong style="color:var(--text-primary)">@ValueOrEmpty(scan.FoodName)</strong>
                                        <span style="font-weight:900;color:var(--primary)">@scan.Calories.ToString("0") @T.Get("common.calories")</span>
                                    </div>
                                    <div style="color:var(--text-secondary);font-size:.78rem;margin-top:5px">
                                        @FormatDate(scan.ScannedAt) - @T.Get("clinic.patientDashboard.confidence") @scan.Confidence%
                                        @if (!string.IsNullOrWhiteSpace(scan.ServingSize))
                                        {
                                            <span> - @scan.ServingSize</span>
                                        }
                                    </div>
                                    <div style="font-size:.78rem;margin-top:5px">
                                        <span class="badge-custom @(scan.LoggedToDashboard ? "badge-primary" : "badge-neutral")">
                                            @(scan.LoggedToDashboard ? T.Get("clinic.patientDashboard.scanLogged") : T.Get("clinic.patientDashboard.scanNotLogged"))
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="hydration-pane" role="tabpanel" aria-labelledby="hydration-tab" tabindex="0">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                    <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.hydrationProgress")</h3>
