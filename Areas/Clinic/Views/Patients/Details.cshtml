                    </div>
                    <div class="patient-list-row mt-2">
                        <div class="d-flex justify-content-between gap-3 flex-wrap">
                            <span style="font-weight:900;color:var(--text-primary)">@T.Get("clinic.patientDashboard.profileUpdatedAt")</span>
                            <span style="color:var(--text-secondary)">@FormatDate(Model.ProfileUpdatedAt)</span>
