                    </div>
                    <div style="color:var(--text-secondary);font-size:.84rem;margin-top:10px">
                        @T.Get("clinic.patientDashboard.todayWater") - @Model.TodayWaterProgressPercent%
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                    <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.waterTrend")</h3>
                    @if (Model.WaterLogs.Count == 0)
                    {
                        <div class="patient-empty mt-3">
                            <i data-lucide="droplets"></i>
                            <div>@T.Get("clinic.patientDashboard.noWaterLogs")</div>
                        </div>
                    }
