                        <span class="patient-metric-icon"><i data-lucide="check-circle-2"></i></span>
                        <div class="patient-metric-value">@Model.WeeklyReport.AdherencePercent%</div>
                        <div class="patient-metric-label">@T.Get("dashboard.adherence")</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="patient-metric">
                        <span class="patient-metric-icon"><i data-lucide="flame"></i></span>
                        <div class="patient-metric-value">@Model.WeeklyReport.AvgCalories.ToString("0")</div>
                        <div class="patient-metric-label">@T.Get("dashboard.avgCalories")</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="patient-metric">
                        <span class="patient-metric-icon"><i data-lucide="calendar-check"></i></span>
                        <div class="patient-metric-value">@Model.WeeklyReport.DaysLogged</div>
                        <div class="patient-metric-label">@T.Get("dashboard.daysLogged")</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="patient-metric">
                        <span class="patient-metric-icon"><i data-lucide="trending-up"></i></span>
                        <div class="patient-metric-value">@(Model.WeeklyReport.Trend >= 0 ? "+" : "")@Model.WeeklyReport.Trend%</div>
                        <div class="patient-metric-label">@T.Get("clinic.patientDashboard.weeklyTrend")</div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                        <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.caloriesVsTarget")</h3>
                        <div class="patient-chart-frame"><canvas id="clinicReportChart"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                        <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.reportSummary")</h3>
                        <div class="patient-compact-list mt-3">
                            <div class="patient-list-row">
                                <div class="d-flex justify-content-between gap-3">
                                    <strong>@T.Get("dashboard.protein")</strong>
                                    <span>@Model.WeeklyReport.AvgProtein.ToString("0.#") / @Model.WeeklyReport.ProteinTarget.ToString("0") @T.Get("common.gram")</span>
                                </div>
                            </div>
                            <div class="patient-list-row">
                                <div class="d-flex justify-content-between gap-3">
                                    <strong>@T.Get("dashboard.carbs")</strong>
                                    <span>@Model.WeeklyReport.AvgCarbs.ToString("0.#") / @Model.WeeklyReport.CarbsTarget.ToString("0") @T.Get("common.gram")</span>
                                </div>
                            </div>
                            <div class="patient-list-row">
                                <div class="d-flex justify-content-between gap-3">
                                    <strong>@T.Get("dashboard.fats")</strong>
                                    <span>@Model.WeeklyReport.AvgFats.ToString("0.#") / @Model.WeeklyReport.FatsTarget.ToString("0") @T.Get("common.gram")</span>
                                </div>
                            </div>
                            <div class="patient-list-row">
                                <div class="d-flex justify-content-between gap-3">
                                    <strong>@T.Get("clinic.patientDashboard.topMood")</strong>
                                    <span>@(string.IsNullOrWhiteSpace(Model.WeeklyReport.TopMood) ? empty : T.Get("mood." + Model.WeeklyReport.TopMood))</span>
                                </div>
                            </div>
                            <div class="patient-list-row">
                                <div class="d-flex justify-content-between gap-3">
                                    <strong>@T.Get("clinic.patientDashboard.avgWater")</strong>
                                    <span>@Model.WeeklyReport.AvgWater.ToString("0.#") / @Model.WeeklyReport.WaterGoal @T.Get("water.glasses")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
    (function () {
        if (typeof Chart === 'undefined') return;

        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const textColor = isDark ? '#e7e5e4' : '#44403c';
        const gridColor = isDark ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.06)';
        const baseOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { labels: { color: textColor, font: { family: 'Cairo, Inter, sans-serif' } } } },
            scales: {
                x: { ticks: { color: textColor }, grid: { color: gridColor } },
                y: { ticks: { color: textColor }, grid: { color: gridColor }, beginAtZero: true }
            }
        };

        const weightLabels = @Html.Raw(weightChartLabels);
        const weightData = @Html.Raw(weightChartData);
        const waterLabels = @Html.Raw(waterChartLabels);
        const waterData = @Html.Raw(waterChartData);
        const reportLabels = @Html.Raw(reportLabels);
        const reportCalories = @Html.Raw(reportCalories);

        const weightCanvas = document.getElementById('clinicWeightChart');
        if (weightCanvas && weightLabels.length > 1) {
            new Chart(weightCanvas, {
                type: 'line',
                data: {
                    labels: weightLabels,
                    datasets: [{
                        label: '@Html.Raw(T.Get("profile.weight"))',
                        data: weightData,
                        borderColor: '#059669',
                        backgroundColor: 'rgba(5,150,105,.14)',
                        pointBackgroundColor: '#059669',
                        tension: .35,
                        fill: true
                    }]
                },
                options: baseOptions
            });
        }

        const waterCanvas = document.getElementById('clinicWaterChart');
        if (waterCanvas && waterLabels.length > 0) {
            new Chart(waterCanvas, {
                type: 'line',
                data: {
                    labels: waterLabels,
                    datasets: [{
                        label: '@Html.Raw(T.Get("water.glasses"))',
                        data: waterData,
                        borderColor: '#0d9488',
                        backgroundColor: 'rgba(13,148,136,.14)',
                        pointBackgroundColor: '#0d9488',
                        tension: .35,
                        fill: true
                    }]
                },
                options: baseOptions
            });
        }

        const reportCanvas = document.getElementById('clinicReportChart');
        if (reportCanvas && reportLabels.length > 0) {
            new Chart(reportCanvas, {
                type: 'bar',
                data: {
                    labels: reportLabels,
                    datasets: [{
                        label: '@Html.Raw(T.Get("dashboard.calories"))',
                        data: reportCalories,
                        backgroundColor: 'rgba(5,150,105,.72)',
                        borderColor: '#059669',
                        borderWidth: 1,
                        borderRadius: 7
                    }]
                },
                options: baseOptions
            });
        }
    })();
</script>
}
