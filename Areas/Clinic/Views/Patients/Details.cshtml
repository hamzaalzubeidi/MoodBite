                                <td>@log.Goal</td>
                                <td>
                                    <div class="patient-progress-bar" style="max-width:180px">
                                        <span style="width:@log.ProgressPercent%"></span>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="tab-pane fade" id="notes-pane" role="tabpanel" aria-labelledby="notes-tab" tabindex="0">
        <div class="card-glass p-4" style="border-radius:var(--radius-lg)">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                <div>
                    <h3 class="patient-section-title">@T.Get("clinic.notes.title")</h3>
                    <p class="patient-section-subtitle">@T.Get("clinic.notes.subtitle")</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-area="Clinic" asp-controller="Notes" asp-action="Index" asp-route-patientId="@Model.PatientId" asp-route-clinicId="@Model.ClinicId" class="btn-secondary-custom btn-sm-custom">
                        <i data-lucide="list"></i>@T.Get("clinic.notes.viewAll")
                    </a>
                    <a asp-area="Clinic" asp-controller="Notes" asp-action="Create" asp-route-patientId="@Model.PatientId" asp-route-clinicId="@Model.ClinicId" class="btn-primary-custom btn-sm-custom">
                        <i data-lucide="plus"></i>@T.Get("clinic.notes.create")
                    </a>
                </div>
            </div>

            @if (Model.ClinicalNotes.Count == 0)
            {
                <div class="patient-empty mt-3">
                    <i data-lucide="clipboard-list"></i>
                    <h3 class="patient-section-title">@T.Get("clinic.notes.noNotes")</h3>
                    <p class="patient-section-subtitle">@T.Get("clinic.notes.noNotesBody")</p>
                </div>
            }
            else
            {
                <div class="patient-compact-list">
                    @foreach (var note in Model.ClinicalNotes)
                    {
                        <div class="patient-list-row">
                            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                <div>
                                    <strong style="color:var(--text-primary)">@note.Title</strong>
                                    <div style="color:var(--text-secondary);font-size:.8rem;margin-top:4px">
                                        @T.Get("clinic.notes.author"): @note.AuthorName - @FormatDateTime(note.CreatedAt)
                                    </div>
                                </div>
                                <span class="badge-custom @(note.IsPrivate ? "badge-neutral" : "badge-primary")">
                                    @(note.IsPrivate ? T.Get("clinic.notes.private") : T.Get("clinic.notes.sharedInternal"))
                                </span>
                            </div>
                            <div style="color:var(--text-secondary);margin-top:8px">@note.Preview</div>
                            <div class="d-flex gap-2 flex-wrap mt-3">
                                <a asp-area="Clinic" asp-controller="Notes" asp-action="Details" asp-route-patientId="@Model.PatientId" asp-route-id="@note.Id" asp-route-clinicId="@Model.ClinicId" class="btn-secondary-custom btn-sm-custom">
                                    <i data-lucide="eye"></i>@T.Get("common.view")
                                </a>
                                <a asp-area="Clinic" asp-controller="Notes" asp-action="Edit" asp-route-patientId="@Model.PatientId" asp-route-id="@note.Id" asp-route-clinicId="@Model.ClinicId" class="btn-secondary-custom btn-sm-custom">
                                    <i data-lucide="pencil"></i>@T.Get("common.edit")
                                </a>
                                <form asp-area="Clinic"
                                      asp-controller="Notes"
                                      asp-action="Delete"
                                      asp-route-patientId="@Model.PatientId"
                                      asp-route-id="@note.Id"
                                      method="post"
                                      onsubmit="return confirm('@T.Get("clinic.notes.deleteConfirm")')">
                                    <input type="hidden" name="clinicId" value="@Model.ClinicId" />
                                    <button type="submit" class="btn-secondary-custom btn-sm-custom">
                                        <i data-lucide="archive"></i>@T.Get("clinic.notes.delete")
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="tab-pane fade" id="reports-pane" role="tabpanel" aria-labelledby="reports-tab" tabindex="0">
