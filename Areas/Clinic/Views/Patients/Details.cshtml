@model ClinicPatientDetailsViewModel
@using System.Text.Json
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("clinic.patients.details");
    var isRtl = T.IsRtl;
    var empty = T.Get("clinic.patientDashboard.notAvailable");
    var weightChartLabels = JsonSerializer.Serialize(Model.WeightHistory.OrderBy(w => w.Date).Select(w => w.Date.ToString("MM/dd")).ToList());
    var weightChartData = JsonSerializer.Serialize(Model.WeightHistory.OrderBy(w => w.Date).Select(w => Math.Round(w.Weight, 1)).ToList());
    var waterChartLabels = JsonSerializer.Serialize(Model.WaterLogs.OrderBy(w => w.Date).Select(w => w.Date.ToString("MM/dd")).ToList());
    var waterChartData = JsonSerializer.Serialize(Model.WaterLogs.OrderBy(w => w.Date).Select(w => w.GlassesCount).ToList());
    var reportLabels = JsonSerializer.Serialize(Model.WeeklyReport.DailyCalories.Select(d => d.Date).ToList());
    var reportCalories = JsonSerializer.Serialize(Model.WeeklyReport.DailyCalories.Select(d => d.Calories).ToList());

    string StatusLabel(string status) => status switch
    {
        "active" => T.Get("common.active"),
        "pending" => T.Get("common.pending"),
        "archived" => T.Get("clinic.status.archived"),
        "discharged" => T.Get("clinic.status.discharged"),
        _ => status
    };

    string StatusBadge(string status) => status switch
    {
        "active" => "badge-primary",
        "pending" => "badge-neutral",
        "archived" or "discharged" => "badge-neutral",
        _ => "badge-neutral"
    };

    string AppointmentStatusLabel(string status) => status switch
    {
        "completed" => T.Get("clinic.appointments.completed"),
        "cancelled" => T.Get("clinic.appointments.cancelled"),
        _ => T.Get("clinic.appointments.scheduled")
    };

    string VisitTypeLabel(string visitType) => visitType switch
    {
        "initial" => T.Get("clinic.appointments.initial"),
        "remote" => T.Get("clinic.appointments.remote"),
        "review" => T.Get("clinic.appointments.review"),
        _ => T.Get("clinic.appointments.followUp")
    };

    string ValueOrEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? empty : value;
    string FormatDate(DateTime? date) => date.HasValue ? date.Value.ToString("yyyy-MM-dd") : empty;
    string FormatDateTime(DateTime? date) => date.HasValue ? date.Value.ToString("yyyy-MM-dd HH:mm") : empty;
    string FormatNumber(double? value, string format = "0.#") => value.HasValue ? value.Value.ToString(format) : empty;
    string FormatKg(double? value) => value.HasValue ? $"{value.Value:0.#} {T.Get("common.kg")}" : empty;
    string FormatCm(double? value) => value.HasValue ? $"{value.Value:0.#} {T.Get("common.cm")}" : empty;
    string FormatCalories(double? value) => value.HasValue ? $"{value.Value:0} {T.Get("common.calories")}" : empty;

    string TranslateValue(string prefix, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return empty;
        var key = prefix + value;
        var translated = T.Get(key);
        return translated == key ? value : translated;
    }

    string ChangeColor(double? change) => change switch
    {
        < 0 => "#10b981",
        > 0 => "#ef4444",
        0 => "var(--text-muted)",
        _ => "var(--text-muted)"
    };

    string SignedKg(double? value)
    {
        if (!value.HasValue) return empty;
        var sign = value.Value > 0 ? "+" : "";
        return $"{sign}{value.Value:0.#} {T.Get("common.kg")}";
    }
}

<style>
    .patient-dashboard-hero {
        background: linear-gradient(135deg,#064e3b 0%,#047857 55%,#0d9488 100%);
        border-radius: var(--radius-lg);
        padding: 22px;
        margin-bottom: 22px;
        box-shadow: var(--shadow-md);
    }
    .patient-dashboard-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 22px;
    }
    .patient-dashboard-tabs .nav-link {
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text-secondary);
        border-radius: var(--radius-sm);
        font-weight: 800;
        padding: 10px 14px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .patient-dashboard-tabs .nav-link.active {
        background: var(--primary-50);
        border-color: var(--primary-100);
        color: var(--primary);
    }
    .patient-dashboard-tabs [data-lucide] {
        width: 17px;
        height: 17px;
    }
    .patient-section-title {
        font-weight: 900;
        color: var(--text-primary);
        margin: 0;
        font-size: 1.03rem;
    }
    .patient-section-subtitle {
        color: var(--text-secondary);
        margin: 4px 0 0;
        font-size: .84rem;
    }
    .patient-metric {
        border: 1px solid var(--border);
        background: var(--surface);
        border-radius: var(--radius-lg);
        padding: 16px;
        min-height: 118px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .patient-metric-icon {
        width: 36px;
        height: 36px;
        border-radius: var(--radius-sm);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--primary-50);
        color: var(--primary);
        margin-bottom: 10px;
    }
    .patient-metric-icon [data-lucide] {
        width: 19px;
        height: 19px;
    }
    .patient-metric-value {
        font-size: 1.28rem;
        font-weight: 900;
        line-height: 1.1;
        color: var(--text-primary);
        overflow-wrap: anywhere;
    }
    .patient-metric-label {
        color: var(--text-secondary);
        font-weight: 800;
        font-size: .78rem;
        margin-top: 6px;
    }
    .patient-info-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }
    .patient-info-item {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 14px;
        background: var(--surface);
        min-height: 84px;
    }
    .patient-info-label {
        color: var(--text-muted);
        font-size: .72rem;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 5px;
    }
    .patient-info-value {
        color: var(--text-primary);
        font-weight: 900;
        overflow-wrap: anywhere;
    }
    .patient-chart-frame {
        height: 260px;
        position: relative;
    }
    .patient-empty {
        border: 1px dashed var(--border);
        border-radius: var(--radius-lg);
        padding: 28px;
        text-align: center;
        color: var(--text-secondary);
        background: var(--surface);
    }
    .patient-empty [data-lucide] {
        width: 34px;
        height: 34px;
        color: var(--primary);
        margin-bottom: 8px;
    }
    .patient-progress-bar {
        height: 10px;
        background: var(--border);
        border-radius: 999px;
        overflow: hidden;
    }
    .patient-progress-bar > span {
        display: block;
        height: 100%;
        background: linear-gradient(90deg,#059669,#0d9488);
        border-radius: 999px;
    }
    .patient-photo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(128px, 1fr));
        gap: 12px;
    }
    .patient-photo {
        aspect-ratio: 3 / 4;
        border-radius: var(--radius-md);
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
    }
    .patient-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .patient-compact-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .patient-list-row {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--surface);
        padding: 12px 14px;
    }
    @@media (max-width: 1100px) {
        .patient-info-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (max-width: 640px) {
        .patient-info-grid { grid-template-columns: 1fr; }
        .patient-dashboard-tabs .nav-link { flex: 1 1 calc(50% - 8px); justify-content: center; }
    }
</style>

<section class="patient-dashboard-hero">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <div style="color:rgba(255,255,255,.72);font-weight:800;font-size:.78rem;text-transform:uppercase">@Model.ClinicName</div>
            <h2 style="color:white;font-weight:900;margin:4px 0;font-size:clamp(1.4rem,3vw,2rem)">@Model.FullName</h2>
            <p style="color:rgba(255,255,255,.72);margin:0">@T.Get("clinic.patients.detailsSubtitle")</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge-custom @StatusBadge(Model.Status)">@StatusLabel(Model.Status)</span>
            <span class="badge-custom @(Model.ConsentGranted ? "badge-primary" : "badge-neutral")">
                @(Model.ConsentGranted ? T.Get("clinic.patients.consentGranted") : T.Get("clinic.patients.consentMissing"))
            </span>
            <a asp-area="Clinic" asp-controller="MealPlans" asp-action="Patient" asp-route-patientId="@Model.PatientId" asp-route-clinicId="@Model.ClinicId" class="btn-secondary-custom" style="background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.28);color:white">
                <i data-lucide="calendar-days"></i>@T.Get("clinic.mealPlans.createReview")
            </a>
            <a asp-area="Clinic" asp-controller="Patients" asp-action="Index" asp-route-clinicId="@Model.ClinicId" class="btn-secondary-custom" style="background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.28);color:white">
                <i data-lucide="arrow-left"></i>@T.Get("clinic.patients.backToRoster")
            </a>
        </div>
    </div>
</section>

<ul class="nav patient-dashboard-tabs" id="patientDashboardTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="overview-tab" data-bs-toggle="pill" data-bs-target="#overview-pane" type="button" role="tab">
            <i data-lucide="layout-dashboard"></i>@T.Get("clinic.patientDashboard.tab.overview")
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="progress-tab" data-bs-toggle="pill" data-bs-target="#progress-pane" type="button" role="tab">
            <i data-lucide="trending-up"></i>@T.Get("clinic.patientDashboard.tab.progress")
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="nutrition-tab" data-bs-toggle="pill" data-bs-target="#nutrition-pane" type="button" role="tab">
            <i data-lucide="utensils"></i>@T.Get("clinic.patientDashboard.tab.nutrition")
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="hydration-tab" data-bs-toggle="pill" data-bs-target="#hydration-pane" type="button" role="tab">
            <i data-lucide="droplets"></i>@T.Get("clinic.patientDashboard.tab.hydration")
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="notes-tab" data-bs-toggle="pill" data-bs-target="#notes-pane" type="button" role="tab">
            <i data-lucide="clipboard-list"></i>@T.Get("clinic.patientDashboard.tab.notes")
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="reports-tab" data-bs-toggle="pill" data-bs-target="#reports-pane" type="button" role="tab">
            <i data-lucide="bar-chart-3"></i>@T.Get("clinic.patientDashboard.tab.reports")
        </button>
    </li>
</ul>

<div class="tab-content" id="patientDashboardTabContent">
    <div class="tab-pane fade show active" id="overview-pane" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-xl-2">
                <div class="patient-metric">
                    <div>
                        <span class="patient-metric-icon"><i data-lucide="scale"></i></span>
                        <div class="patient-metric-value">@FormatKg(Model.CurrentWeight)</div>
                    </div>
                    <div class="patient-metric-label">@T.Get("clinic.patientDashboard.currentWeight")</div>
                </div>
            </div>
            <div class="col-md-4 col-xl-2">
                <div class="patient-metric">
                    <div>
                        <span class="patient-metric-icon"><i data-lucide="activity"></i></span>
                        <div class="patient-metric-value" style="color:@ChangeColor(Model.WeightChange)">@SignedKg(Model.WeightChange)</div>
                    </div>
                    <div class="patient-metric-label">@T.Get("clinic.patientDashboard.weightChange")</div>
                </div>
            </div>
            <div class="col-md-4 col-xl-2">
                <div class="patient-metric">
                    <div>
                        <span class="patient-metric-icon"><i data-lucide="flame"></i></span>
                        <div class="patient-metric-value">@FormatCalories(Model.CalorieTarget)</div>
                    </div>
                    <div class="patient-metric-label">@T.Get("clinic.patientDashboard.dailyCalorieTarget")</div>
                </div>
            </div>
            <div class="col-md-4 col-xl-2">
                <div class="patient-metric">
                    <div>
                        <span class="patient-metric-icon"><i data-lucide="droplet"></i></span>
                        <div class="patient-metric-value">@Model.WaterTarget @T.Get("water.glasses")</div>
                    </div>
                    <div class="patient-metric-label">@T.Get("clinic.patientDashboard.waterTarget")</div>
                </div>
            </div>
            <div class="col-md-4 col-xl-2">
                <div class="patient-metric">
                    <div>
                        <span class="patient-metric-icon"><i data-lucide="calendar-days"></i></span>
                        <div class="patient-metric-value" style="font-size:1.02rem">
                            @(Model.MealPlan.HasPlan ? T.Get("clinic.patientDashboard.activeMealPlan") : T.Get("clinic.patientDashboard.noMealPlan"))
                        </div>
                    </div>
                    <div class="patient-metric-label">@T.Get("clinic.patientDashboard.mealPlanStatus")</div>
                </div>
            </div>
            <div class="col-md-4 col-xl-2">
                <div class="patient-metric">
                    <div>
                        <span class="patient-metric-icon"><i data-lucide="pulse"></i></span>
                        <div class="patient-metric-value" style="font-size:1.02rem">
                            @(string.IsNullOrWhiteSpace(Model.RecentActivityKey) ? T.Get("clinic.patientDashboard.noRecentActivity") : T.Get(Model.RecentActivityKey))
                        </div>
                    </div>
                    <div class="patient-metric-label">@FormatDate(Model.RecentActivityAt)</div>
                </div>
            </div>
        </div>

        <div class="card-glass p-4 mb-4" style="border-radius:var(--radius-lg)">
            <div class="mb-3">
                <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.patientOverview")</h3>
                <p class="patient-section-subtitle">@T.Get("clinic.patientDashboard.patientOverviewSubtitle")</p>
            </div>
            <div class="patient-info-grid">
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("auth.fullName")</div>
                    <div class="patient-info-value">@Model.FullName</div>
                </div>
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("auth.email")</div>
                    <div class="patient-info-value">@ValueOrEmpty(Model.Email)</div>
                </div>
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("profile.age")</div>
                    <div class="patient-info-value">@(Model.Age.HasValue ? Model.Age.Value : empty)</div>
                </div>
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("profile.gender")</div>
                    <div class="patient-info-value">@TranslateValue("profile.", Model.Gender)</div>
                </div>
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("profile.height")</div>
                    <div class="patient-info-value">@FormatCm(Model.Height)</div>
                </div>
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("profile.weight")</div>
                    <div class="patient-info-value">@FormatKg(Model.ProfileWeight)</div>
                </div>
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("clinic.patientDashboard.bmi")</div>
                    <div class="patient-info-value">@FormatNumber(Model.Bmi)</div>
                </div>
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("clinic.patientDashboard.goal")</div>
                    <div class="patient-info-value">@TranslateValue("profile.goal.", Model.Goal)</div>
                </div>
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("clinic.patientStatus")</div>
                    <div class="patient-info-value"><span class="badge-custom @StatusBadge(Model.Status)">@StatusLabel(Model.Status)</span></div>
                </div>
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("clinic.patients.consent")</div>
                    <div class="patient-info-value">
                        @(Model.ConsentGranted ? T.Get("clinic.patients.consentGranted") : T.Get("clinic.patients.consentMissing"))
                    </div>
                </div>
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("clinic.patients.assignedTo")</div>
                    <div class="patient-info-value">@ValueOrEmpty(Model.PrimaryDietitianName)</div>
                </div>
                <div class="patient-info-item">
                    <div class="patient-info-label">@T.Get("clinic.patients.linkedAt")</div>
                    <div class="patient-info-value">@FormatDate(Model.LinkedAt)</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.latestMealPlan")</h3>
                            <p class="patient-section-subtitle">@T.Get("clinic.mealPlans.latestPlanSubtitle")</p>
                        </div>
                        <a asp-area="Clinic" asp-controller="MealPlans" asp-action="Patient" asp-route-patientId="@Model.PatientId" asp-route-clinicId="@Model.ClinicId" class="btn-secondary-custom btn-sm-custom">
                            <i data-lucide="calendar-days"></i>@T.Get("clinic.mealPlans.createReview")
                        </a>
                    </div>
                    @if (!Model.MealPlan.HasPlan)
                    {
                        <div class="patient-empty mt-3">
                            <i data-lucide="calendar-x"></i>
                            <div>@T.Get("clinic.patientDashboard.noMealPlanBody")</div>
                            <a asp-area="Clinic" asp-controller="MealPlans" asp-action="Create" asp-route-patientId="@Model.PatientId" asp-route-clinicId="@Model.ClinicId" class="btn-primary-custom mt-3">
                                <i data-lucide="plus"></i>@T.Get("clinic.mealPlans.createPlan")
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="patient-info-grid mt-3" style="grid-template-columns:repeat(2,minmax(0,1fr))">
                            <div class="patient-info-item">
                                <div class="patient-info-label">@T.Get("mealPlan.title")</div>
                                <div class="patient-info-value">@ValueOrEmpty(Model.MealPlan.Title)</div>
                            </div>
                            <div class="patient-info-item">
                                <div class="patient-info-label">@T.Get("clinic.patientDashboard.planType")</div>
                                <div class="patient-info-value">@ValueOrEmpty(Model.MealPlan.PlanType)</div>
                            </div>
                            <div class="patient-info-item">
                                <div class="patient-info-label">@T.Get("diets.title")</div>
                                <div class="patient-info-value">@ValueOrEmpty(Model.MealPlan.DietType)</div>
                            </div>
                            <div class="patient-info-item">
                                <div class="patient-info-label">@T.Get("profile.calorieTarget")</div>
                                <div class="patient-info-value">@FormatCalories(Model.MealPlan.CalorieTarget)</div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap" style="color:var(--text-secondary);font-size:.82rem;margin-top:12px">
                            <span>@T.Get("clinic.patientDashboard.createdAt"): @FormatDate(Model.MealPlan.CreatedAt)</span>
                            <span class="badge-custom badge-primary">@T.Get("clinic.mealPlans.assignedStatus")</span>
                        </div>
                        @if (Model.MealPlan.PlanId.HasValue)
                        {
                            <div class="mt-3">
                                <a asp-area="Clinic" asp-controller="MealPlans" asp-action="Details" asp-route-id="@Model.MealPlan.PlanId" asp-route-clinicId="@Model.ClinicId" class="btn-secondary-custom btn-sm-custom">
                                    <i data-lucide="eye"></i>@T.Get("clinic.mealPlans.reviewPlan")
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <h3 class="patient-section-title">@T.Get("clinic.appointments.upcoming")</h3>
                            <p class="patient-section-subtitle">@T.Get("clinic.appointments.patientUpcomingSubtitle")</p>
                        </div>
                        <a asp-area="Clinic" asp-controller="Appointments" asp-action="Create" asp-route-clinicId="@Model.ClinicId" asp-route-patientId="@Model.PatientId" class="btn-secondary-custom btn-sm-custom">
                            <i data-lucide="calendar-plus"></i>@T.Get("clinic.appointments.schedule")
                        </a>
                    </div>
                    @if (Model.UpcomingAppointments.Count == 0)
                    {
                        <div class="patient-empty mt-3">
                            <i data-lucide="calendar-x"></i>
                            <div>@T.Get("clinic.appointments.noUpcoming")</div>
                        </div>
                    }
                    else
                    {
                        <div class="patient-compact-list mt-3">
                            @foreach (var appointment in Model.UpcomingAppointments.Take(3))
                            {
                                <div class="patient-list-row">
                                    <div class="d-flex justify-content-between gap-3 flex-wrap">
                                        <strong style="color:var(--text-primary)">@FormatDateTime(appointment.StartsAt)</strong>
                                        <span class="badge-custom badge-primary">@AppointmentStatusLabel(appointment.Status)</span>
                                    </div>
                                    <div style="color:var(--text-secondary);font-size:.82rem;margin-top:5px">
                                        @VisitTypeLabel(appointment.VisitType) - @appointment.DurationMinutes @T.Get("clinic.appointments.minutes")
                                    </div>
                                    <div class="mt-2">
                                        <a asp-area="Clinic" asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.Id" asp-route-clinicId="@Model.ClinicId" class="btn-secondary-custom btn-sm-custom">
                                            <i data-lucide="eye"></i>@T.Get("common.view")
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                    <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.profileFreshness")</h3>
                    <div class="patient-list-row mt-3">
                        <div class="d-flex justify-content-between gap-3 flex-wrap">
