                    {
                        <div class="patient-chart-frame"><canvas id="clinicWaterChart"></canvas></div>
                    }
                </div>
            </div>
        </div>

        <div class="card-glass p-4 mt-4" style="border-radius:var(--radius-lg)">
            <h3 class="patient-section-title">@T.Get("clinic.patientDashboard.waterLogs")</h3>
            @if (Model.WaterLogs.Count == 0)
            {
                <div class="patient-empty mt-3">
                    <i data-lucide="droplet-off"></i>
                    <div>@T.Get("clinic.patientDashboard.noWaterLogs")</div>
                </div>
            }
            else
            {
                <div class="table-responsive mt-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@T.Get("clinic.patientDashboard.date")</th>
                                <th>@T.Get("water.glasses")</th>
                                <th>@T.Get("dashboard.target")</th>
                                <th>@T.Get("clinic.patientDashboard.progressPercent")</th>
