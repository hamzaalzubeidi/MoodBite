@model ClinicAcceptInvitationViewModel
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("clinic.invitations.acceptTitle");
    var returnUrl = Context.Request.Path.ToString() + Context.Request.QueryString.ToString();
}

<div class="card-glass p-5 text-center" style="border-radius:var(--radius-lg);max-width:760px;margin:0 auto">
    <div style="width:74px;height:74px;border-radius:var(--radius-lg);background:var(--primary-50);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;color:var(--primary)">
        <i data-lucide="mail-check" style="width:36px;height:36px"></i>
    </div>

    @if (Model.IsAccepted)
    {
        <h2 style="font-weight:900;color:var(--text-primary);font-size:1.35rem">@T.Get("clinic.invitations.acceptedTitle")</h2>
        <p style="color:var(--text-secondary);max-width:560px;margin:10px auto 24px">
            @Model.Message
        </p>
        <a asp-area="" asp-controller="Dashboard" asp-action="Index" class="btn-primary-custom">
            <i data-lucide="layout-dashboard"></i>@T.Get("nav.dashboard")
        </a>
    }
    else if (!Model.IsValid)
    {
        <h2 style="font-weight:900;color:var(--text-primary);font-size:1.35rem">@T.Get("clinic.invitations.unavailableTitle")</h2>
        <p style="color:var(--text-secondary);max-width:560px;margin:10px auto 0">
            @Model.Message
        </p>
    }
    else
    {
        <h2 style="font-weight:900;color:var(--text-primary);font-size:1.35rem">@T.Get("clinic.invitations.acceptTitle")</h2>
        <p style="color:var(--text-secondary);max-width:560px;margin:10px auto 20px">
            @T.Get("clinic.invitations.acceptBody")
        </p>

        <div class="row g-3 text-start mb-4" style="max-width:520px;margin-inline:auto">
            <div class="col-sm-6">
                <div style="font-size:.76rem;color:var(--text-muted);font-weight:800;text-transform:uppercase">@T.Get("clinic.clinic")</div>
                <div style="font-weight:900;color:var(--text-primary)">@Model.ClinicName</div>
            </div>
            <div class="col-sm-6">
                <div style="font-size:.76rem;color:var(--text-muted);font-weight:800;text-transform:uppercase">@T.Get("auth.email")</div>
                <div style="font-weight:900;color:var(--text-primary)">@Model.Email</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-warning" style="max-width:560px;margin-inline:auto">@Model.Message</div>
        }

        @if (!Model.IsAuthenticated)
        {
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" class="btn-primary-custom">
                    <i data-lucide="log-in"></i>@T.Get("auth.login")
                </a>
                <a asp-area="" asp-controller="Account" asp-action="Register" class="btn-secondary-custom">
                    <i data-lucide="user-plus"></i>@T.Get("auth.register")
                </a>
            </div>
        }
        else
        {
            <form asp-area="Clinic" asp-controller="Patients" asp-action="AcceptInvitation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@Model.Token" />
                <button type="submit" class="btn-primary-custom">
                    <i data-lucide="check-circle"></i>@T.Get("clinic.invitations.accept")
                </button>
            </form>
        }
    }
</div>
