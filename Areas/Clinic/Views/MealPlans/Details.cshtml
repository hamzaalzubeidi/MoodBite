@model ClinicMealPlanDetailsViewModel
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("clinic.mealPlans.reviewPlan");
    var empty = T.Get("clinic.patientDashboard.notAvailable");

    string FormatKg(double? value) => value.HasValue ? $"{value.Value:0.#} {T.Get("common.kg")}" : empty;
    string FormatCalories(double? value) => value.HasValue ? $"{value.Value:0} {T.Get("common.calories")}" : empty;
    string PlanTypeLabel(string type) => type == "ai" ? T.Get("clinic.mealPlans.aiPlan") : T.Get("clinic.mealPlans.manualPlan");
    string DayName(ClinicMealPlanDayViewModel day) => T.IsRtl
        ? day.DayNameAr ?? day.DayNameEn ?? $"{T.Get("clinic.patientDashboard.date")} {day.Day}"
        : day.DayNameEn ?? day.DayNameAr ?? $"Day {day.Day}";
    string MealName(ClinicMealPlanMealViewModel meal) => T.IsRtl
        ? meal.NameAr ?? meal.NameEn ?? empty
        : meal.NameEn ?? meal.NameAr ?? empty;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section style="background:linear-gradient(135deg,#064e3b 0%,#047857 55%,#0d9488 100%);border-radius:var(--radius-lg);padding:22px;margin-bottom:22px;box-shadow:var(--shadow-md)">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <div style="color:rgba(255,255,255,.72);font-weight:800;font-size:.78rem;text-transform:uppercase">@Model.ClinicName</div>
            <h2 style="color:white;font-weight:900;margin:4px 0;font-size:clamp(1.4rem,3vw,2rem)">@T.Get("clinic.mealPlans.reviewPlan")</h2>
            <p style="color:rgba(255,255,255,.72);margin:0">@Model.Patient.FullName</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-area="Clinic"
               asp-controller="MealPlans"
               asp-action="Patient"
               asp-route-patientId="@Model.Patient.PatientId"
               asp-route-clinicId="@Model.ClinicId"
               class="btn-secondary-custom"
               style="background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.28);color:white">
                <i data-lucide="arrow-left"></i>@T.Get("clinic.mealPlans.backToPatientPlans")
            </a>
            <a asp-area="Clinic"
               asp-controller="MealPlans"
               asp-action="Edit"
               asp-route-id="@Model.Plan.Id"
               asp-route-clinicId="@Model.ClinicId"
               class="btn-secondary-custom"
               style="background:white;color:var(--primary);border-color:white">
                <i data-lucide="pencil"></i>@T.Get("common.edit")
            </a>
        </div>
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h4 style="font-weight:900;margin:0">@Model.Plan.Title</h4>
                    <p style="color:var(--text-secondary);font-size:.84rem;margin:6px 0 0">@Model.Plan.CreatedAt.ToString("yyyy-MM-dd")</p>
                </div>
                <span class="badge-custom @(Model.Plan.IsLatestAssigned ? "badge-primary" : "badge-neutral")">
                    @(Model.Plan.IsLatestAssigned ? T.Get("clinic.mealPlans.assignedStatus") : T.Get("clinic.mealPlans.reviewStatus"))
                </span>
            </div>
            <div class="row g-3">
                <div class="col-6">
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("clinic.patientDashboard.planType")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@PlanTypeLabel(Model.Plan.PlanType)</div>
                </div>
                <div class="col-6">
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("diets.title")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@(!string.IsNullOrWhiteSpace(Model.Plan.DietType) ? Model.Plan.DietType : empty)</div>
                </div>
                <div class="col-6">
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("profile.calorieTarget")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@FormatCalories(Model.Plan.CalorieTarget)</div>
                </div>
                <div class="col-6">
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("clinic.mealPlans.daysInPlan")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@Model.Plan.DayCount</div>
                </div>
            </div>

            <hr style="border-color:var(--border);margin:18px 0" />

            <div class="d-flex flex-column gap-2">
                @if (!Model.Plan.IsLatestAssigned)
                {
                    <form asp-area="Clinic"
                          asp-controller="MealPlans"
                          asp-action="Assign"
                          asp-route-id="@Model.Plan.Id"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="clinicId" value="@Model.ClinicId" />
                        <button type="submit" class="btn-primary-custom w-100">
                            <i data-lucide="check-circle"></i>@T.Get("clinic.mealPlans.assignPlan")
                        </button>
                    </form>
                    <p style="color:var(--text-secondary);font-size:.78rem;margin:0">@T.Get("clinic.mealPlans.assignHint")</p>
                }
                else
                {
                    <div class="alert alert-success mb-0" style="border-radius:var(--radius-md)">
                        <i class="bi bi-check-circle me-2"></i>@T.Get("clinic.mealPlans.alreadyAssigned")
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
            <h5 style="font-weight:900;margin-bottom:14px">@T.Get("clinic.mealPlans.patientSummary")</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("auth.email")</div>
                    <div style="font-weight:900;color:var(--text-primary);overflow-wrap:anywhere">@Model.Patient.Email</div>
                </div>
                <div class="col-md-6">
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("clinic.patientDashboard.goal")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@(!string.IsNullOrWhiteSpace(Model.Patient.Goal) ? Model.Patient.Goal : empty)</div>
                </div>
                <div class="col-md-4">
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("profile.recommendedDiet")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@(!string.IsNullOrWhiteSpace(Model.Patient.DietSlug) ? Model.Patient.DietSlug : empty)</div>
                </div>
                <div class="col-md-4">
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("clinic.patientDashboard.currentWeight")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@FormatKg(Model.Patient.LatestWeight)</div>
                </div>
                <div class="col-md-4">
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("clinic.patientDashboard.bmi")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@(Model.Patient.Bmi?.ToString("0.#") ?? empty)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card-glass p-4" style="border-radius:var(--radius-lg)">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 style="font-weight:900;margin:0">@T.Get("clinic.mealPlans.preview")</h4>
            <p style="color:var(--text-secondary);margin:4px 0 0;font-size:.84rem">@T.Get("clinic.mealPlans.previewSubtitle")</p>
        </div>
        <span class="badge-custom badge-primary">@Model.Days.Count @T.Get("clinic.mealPlans.daysInPlan")</span>
    </div>

    @if (Model.Days.Count == 0)
    {
        <div class="text-center py-5">
            <div style="font-size:2.4rem;color:var(--primary);margin-bottom:10px"><i data-lucide="file-warning"></i></div>
            <h6 style="font-weight:800">@T.Get("clinic.mealPlans.previewUnavailable")</h6>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var day in Model.Days)
            {
                <div class="col-xl-4 col-md-6">
                    <div style="border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;background:var(--surface);height:100%">
                        <div style="background:linear-gradient(135deg,#059669,#0d9488);color:white;padding:12px 14px;text-align:center">
                            <div style="font-weight:900">@DayName(day)</div>
                            <div style="font-size:.76rem;opacity:.86">@day.TotalCalories.ToString("0") @T.Get("common.calories")</div>
                        </div>
                        <div class="d-flex flex-column gap-2" style="padding:12px">
                            @foreach (var meal in day.Meals)
                            {
                                <div style="background:var(--surface-2);border-radius:var(--radius-md);padding:10px;border-inline-start:3px solid var(--primary)">
                                    <div style="font-size:.7rem;color:var(--primary);font-weight:900;text-transform:uppercase">@meal.Type</div>
                                    <div style="font-weight:800;color:var(--text-primary);font-size:.9rem">@MealName(meal)</div>
                                    <div style="font-size:.74rem;color:var(--text-secondary);margin-top:4px">
                                        @meal.Calories.ToString("0") @T.Get("common.calories") -
                                        @T.Get("dashboard.protein") @meal.Protein.ToString("0.#")g -
                                        @T.Get("dashboard.carbs") @meal.Carbs.ToString("0.#")g -
                                        @T.Get("dashboard.fats") @meal.Fats.ToString("0.#")g
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
