@model ClinicNoteDetailsViewModel
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("clinic.notes.details");
    var empty = T.Get("clinic.patientDashboard.notAvailable");

    string FormatDate(DateTime? date) => date.HasValue ? date.Value.ToString("yyyy-MM-dd HH:mm") : empty;
}

<section style="background:linear-gradient(135deg,#064e3b 0%,#047857 55%,#0d9488 100%);border-radius:var(--radius-lg);padding:22px;margin-bottom:22px;box-shadow:var(--shadow-md)">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <div style="color:rgba(255,255,255,.72);font-weight:800;font-size:.78rem;text-transform:uppercase">@Model.ClinicName</div>
            <h2 style="color:white;font-weight:900;margin:4px 0;font-size:clamp(1.4rem,3vw,2rem)">@Model.Note.Title</h2>
            <p style="color:rgba(255,255,255,.72);margin:0">@Model.Patient.FullName</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-area="Clinic"
               asp-controller="Notes"
               asp-action="Edit"
               asp-route-patientId="@Model.Patient.PatientId"
               asp-route-id="@Model.Note.Id"
               asp-route-clinicId="@Model.ClinicId"
               class="btn-secondary-custom"
               style="background:white;color:var(--primary);border-color:white">
                <i data-lucide="pencil"></i>@T.Get("clinic.notes.edit")
            </a>
            <a asp-area="Clinic"
               asp-controller="Notes"
               asp-action="Index"
               asp-route-patientId="@Model.Patient.PatientId"
               asp-route-clinicId="@Model.ClinicId"
               class="btn-secondary-custom"
               style="background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.28);color:white">
                <i data-lucide="arrow-left"></i>@T.Get("clinic.notes.backToNotes")
            </a>
        </div>
    </div>
</section>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-3">
                <div>
                    <h4 style="font-weight:900;margin:0">@Model.Note.Title</h4>
                    <p style="color:var(--text-secondary);margin:4px 0 0">@T.Get("clinic.notes.content")</p>
                </div>
                <span class="badge-custom @(Model.IsPrivate ? "badge-neutral" : "badge-primary")">
                    @(Model.IsPrivate ? T.Get("clinic.notes.private") : T.Get("clinic.notes.sharedInternal"))
                </span>
            </div>
            <div style="white-space:pre-wrap;color:var(--text-primary);line-height:1.8">@Model.Content</div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
            <h5 style="font-weight:900;margin:0 0 14px">@T.Get("clinic.notes.details")</h5>
            <div class="d-flex flex-column gap-3">
                <div>
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("clinic.notes.author")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@Model.Note.AuthorName</div>
                </div>
                <div>
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("clinic.notes.createdAt")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@FormatDate(Model.Note.CreatedAt)</div>
                </div>
                <div>
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("clinic.notes.updatedAt")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@FormatDate(Model.UpdatedAt)</div>
                </div>
                <div>
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;text-transform:uppercase">@T.Get("clinic.notes.type")</div>
                    <div style="font-weight:900;color:var(--text-primary)">@Model.NoteType</div>
                </div>
            </div>
            <form asp-area="Clinic"
                  asp-controller="Notes"
                  asp-action="Delete"
                  asp-route-patientId="@Model.Patient.PatientId"
                  asp-route-id="@Model.Note.Id"
                  method="post"
                  class="mt-4"
                  onsubmit="return confirm('@T.Get("clinic.notes.deleteConfirm")')">
                <input type="hidden" name="clinicId" value="@Model.ClinicId" />
                <button type="submit" class="btn-secondary-custom w-100">
                    <i data-lucide="archive"></i>@T.Get("clinic.notes.delete")
                </button>
            </form>
        </div>
    </div>
</div>
