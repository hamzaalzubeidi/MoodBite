@model ClinicDashboardShellViewModel
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("clinic.dashboard");
    var isRtl = T.CurrentLang == "ar";
    var cards = new[]
    {
        (Icon: "users", Label: T.Get("clinic.activePatients"), Value: Model.ActivePatients, Color: "var(--primary)"),
        (Icon: "user-round-check", Label: T.Get("clinic.patientsNeedFollowUp"), Value: Model.PatientsNeedingFollowUp, Color: "var(--icon-amber)"),
        (Icon: "file-check-2", Label: T.Get("clinic.reportsReady"), Value: Model.ReportsReady, Color: "var(--icon-blue)"),
        (Icon: "calendar-clock", Label: T.Get("clinic.upcomingAppointments"), Value: Model.UpcomingAppointments, Color: "var(--icon-purple)")
    };
}

<section style="background:linear-gradient(135deg,#064e3b 0%,#065f46 45%,#0d9488 100%);border-radius:var(--radius-lg);padding:24px;margin-bottom:24px;box-shadow:var(--shadow-md);overflow:hidden">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <div style="color:rgba(255,255,255,.72);font-weight:800;font-size:.78rem;text-transform:uppercase">@T.Get("clinic.title")</div>
            <h2 style="color:white;font-weight:900;margin:4px 0;font-size:clamp(1.45rem,3vw,2.1rem)">
                @(Model.HasActiveClinicContext ? Model.ClinicName : T.Get("clinic.dashboard"))
            </h2>
            <p style="color:rgba(255,255,255,.72);margin:0;max-width:720px">
                @T.Get("clinic.dashboardSubtitle")
            </p>
        </div>
        <div style="width:56px;height:56px;border-radius:var(--radius-lg);background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;color:white">
            <i data-lucide="stethoscope" style="width:30px;height:30px"></i>
        </div>
    </div>
</section>

@if (!Model.HasActiveClinicContext)
{
    <div class="card-glass p-5 text-center" style="border-radius:var(--radius-lg);max-width:760px;margin:0 auto">
        <div style="width:70px;height:70px;border-radius:var(--radius-lg);background:var(--primary-50);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;color:var(--primary)">
            <i data-lucide="building-2" style="width:34px;height:34px"></i>
        </div>
        <h3 style="font-weight:900;color:var(--text-primary);font-size:1.25rem">@T.Get("clinic.emptyTitle")</h3>
        <p style="color:var(--text-secondary);max-width:560px;margin:8px auto 0">
            @(Model.ClinicDataUnavailable ? T.Get("clinic.dataUnavailable") : T.Get("clinic.emptyBody"))
        </p>
        @if (Model.IsPlatformAdmin)
        {
            <div class="badge-custom badge-primary mt-4">
                <i data-lucide="shield-check" style="width:14px;height:14px"></i>
                @T.Get("clinic.adminCanConfigureLater")
            </div>
        }
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var card in cards)
        {
            <div class="col-md-6 col-xl-3 d-flex">
                <div class="stat-card p-4 w-100" style="border-radius:var(--radius-lg);min-height:142px">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div style="font-size:2rem;font-weight:900;color:@card.Color;line-height:1">@card.Value</div>
                            <div style="font-size:.86rem;color:var(--text-secondary);font-weight:700;margin-top:8px">@card.Label</div>
                        </div>
                        <div style="width:42px;height:42px;border-radius:var(--radius-md);background:var(--primary-50);display:flex;align-items:center;justify-content:center;color:@card.Color">
                            <i data-lucide="@card.Icon"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card-glass p-4" style="border-radius:var(--radius-lg)">
        <div class="d-flex align-items-start gap-3">
            <div style="width:44px;height:44px;border-radius:var(--radius-md);background:var(--primary-50);display:flex;align-items:center;justify-content:center;color:var(--primary);flex-shrink:0">
                <i data-lucide="info"></i>
            </div>
            <div>
                <h5 style="font-weight:900;margin:0 0 6px;color:var(--text-primary)">@T.Get("clinic.shellReadyTitle")</h5>
                <p style="color:var(--text-secondary);margin:0">
                    @T.Get("clinic.shellReadyBody")
                </p>
                <a href="/Clinic/Patients?clinicId=@Model.ClinicId" class="btn-primary-custom btn-sm-custom mt-3">
                    <i data-lucide="users"></i>@T.Get("clinic.patients.openRoster")
                </a>
            </div>
        </div>
    </div>
}
