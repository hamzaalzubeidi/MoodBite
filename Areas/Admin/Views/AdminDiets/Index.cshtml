@model List<MoodBite.Models.Diet>
@using MoodBite.Services
@inject TranslationService T
@{
    ViewData["Title"] = T.CurrentLang == "ar" ? "إدارة الأنظمة الغذائية" : "Manage Diets";
    var isRtl = T.CurrentLang == "ar";
}

<div class="card-glass p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 style="font-weight:700;margin:0">
            <i class="bi bi-list-check text-primary me-2"></i>
            @(isRtl?"الأنظمة الغذائية":"Diets") (@Model.Count)
        </h5>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@(isRtl?"النظام":"Diet")</th>
                    <th>@(isRtl?"الفئة":"Category")</th>
                    <th>@(isRtl?"الصعوبة":"Difficulty")</th>
                    <th>@(isRtl?"السعرات":"Calories")</th>
                    <th>@(isRtl?"الحالة":"Status")</th>
                    <th>@(isRtl?"إجراء":"Action")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var diet in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span style="font-size:1.4rem">@diet.Emoji</span>
                                <div>
                                    <div style="font-weight:700">@(isRtl ? diet.NameAr : diet.NameEn)</div>
                                    <div class="text-muted small">@diet.Slug</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-info text-dark">@diet.Category</span></td>
                        <td><span class="badge bg-@(diet.Difficulty == "hard" ? "danger" : diet.Difficulty == "medium" ? "warning text-dark" : "success")">@diet.Difficulty</span></td>
                        <td class="small">@diet.CalorieMin–@diet.CalorieMax</td>
                        <td>
                            <span class="badge bg-@(diet.IsActive ? "success" : "secondary")">
                                @(diet.IsActive ? (isRtl?"نشط":"Active") : (isRtl?"معطل":"Inactive"))
                            </span>
                        </td>
                        <td>
                            <form asp-action="ToggleActive" method="post" class="d-inline">
                                <input type="hidden" name="dietId" value="@diet.Id" />
                                <button type="submit" class="btn-@(diet.IsActive ? "danger" : "primary")-custom btn-sm"
                                        style="padding:4px 12px;font-size:.75rem">
                                    @(diet.IsActive ? (isRtl?"تعطيل":"Disable") : (isRtl?"تفعيل":"Enable"))
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
