@model AdminClinicManagementViewModel
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("clinic.admin.title");
    var isRtl = T.CurrentLang == "ar";
}

@if (Model.ClinicDataUnavailable)
{
    <div class="card-glass p-5 text-center" style="border-radius:var(--radius-lg)">
        <div style="width:68px;height:68px;border-radius:var(--radius-lg);background:var(--primary-50);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;color:var(--primary)">
            <i class="bi bi-database-exclamation" style="font-size:2rem"></i>
        </div>
        <h4 style="font-weight:900">@T.Get("clinic.dataUnavailable")</h4>
        <p style="color:var(--text-secondary);margin:8px auto 0;max-width:620px">@T.Get("clinic.admin.applyMigrationHint")</p>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                <h5 style="font-weight:900;margin-bottom:16px">
                    <i class="bi bi-hospital text-primary me-2"></i>@T.Get("clinic.admin.createClinic")
                </h5>
                <form asp-area="Admin" asp-controller="AdminClinics" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">@T.Get("clinic.field.name")</label>
                        <input name="Name" class="form-control" maxlength="160" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@T.Get("clinic.field.legalName")</label>
                        <input name="LegalName" class="form-control" maxlength="160" />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">@T.Get("auth.email")</label>
                            <input name="Email" type="email" class="form-control" maxlength="256" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T.Get("clinic.field.phone")</label>
                            <input name="Phone" class="form-control" maxlength="40" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T.Get("clinic.field.country")</label>
                            <input name="Country" class="form-control" maxlength="120" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T.Get("clinic.field.city")</label>
                            <input name="City" class="form-control" maxlength="120" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">@T.Get("clinic.field.address")</label>
                        <input name="Address" class="form-control" maxlength="300" />
                    </div>
                    <button type="submit" class="btn-primary-custom mt-4">
                        <i class="bi bi-plus-circle"></i>@T.Get("clinic.admin.createClinic")
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card-glass p-4 h-100" style="border-radius:var(--radius-lg)">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 style="font-weight:900;margin:0">
                        <i class="bi bi-buildings text-primary me-2"></i>@T.Get("clinic.clinics")
                    </h5>
                    <span class="badge-custom badge-primary">@Model.Clinics.Count</span>
                </div>

                @if (Model.Clinics.Count == 0)
                {
                    <div class="text-center py-5">
                        <div style="font-size:2.4rem;color:var(--primary);margin-bottom:10px"><i class="bi bi-hospital"></i></div>
                        <h6 style="font-weight:800">@T.Get("clinic.admin.noClinics")</h6>
                        <p style="color:var(--text-secondary);margin:0">@T.Get("clinic.admin.noClinicsBody")</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>@T.Get("clinic.clinic")</th>
                                    <th>@T.Get("clinic.members")</th>
                                    <th>@T.Get("clinic.patients")</th>
                                    <th>@T.Get("clinic.field.status")</th>
                                    <th>@T.Get("common.view")</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var clinic in Model.Clinics)
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight:800">@clinic.Name</div>
                                        <div style="font-size:.76rem;color:var(--text-muted)">@clinic.Slug</div>
                                        @if (!string.IsNullOrWhiteSpace(clinic.City) || !string.IsNullOrWhiteSpace(clinic.Country))
                                        {
                                            <div style="font-size:.76rem;color:var(--text-secondary)">@clinic.City @clinic.Country</div>
                                        }
                                    </td>
                                    <td>@clinic.MemberCount</td>
                                    <td>@clinic.PatientCount</td>
                                    <td>
                                        <span class="badge bg-@(clinic.IsActive ? "success" : "secondary")">
                                            @(clinic.IsActive ? T.Get("common.active") : T.Get("common.inactive"))
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <a href="/Clinic/ClinicSettings?clinicId=@clinic.Id" class="btn-ghost-custom btn-sm">@T.Get("clinic.nav.settings")</a>
                                            <a href="/Clinic/ClinicStaff?clinicId=@clinic.Id" class="btn-ghost-custom btn-sm">@T.Get("clinic.nav.staff")</a>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="5" style="background:var(--surface-2)">
                                        <form asp-area="Admin" asp-controller="AdminClinics" asp-action="AssignOwner" method="post" class="d-flex flex-wrap align-items-end gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ClinicId" value="@clinic.Id" />
                                            <div style="min-width:260px">
                                                <label class="form-label" style="font-size:.78rem">@T.Get("clinic.admin.ownerEmail")</label>
                                                <input name="Email" type="email" class="form-control form-control-sm" required />
                                            </div>
                                            <button type="submit" class="btn-secondary-custom btn-sm-custom">
                                                <i class="bi bi-person-check"></i>@T.Get("clinic.admin.assignOwner")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}
