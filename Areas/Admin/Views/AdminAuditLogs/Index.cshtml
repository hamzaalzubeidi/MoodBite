@model MoodBite.ViewModels.AuditLogIndexViewModel
@using MoodBite.Services
@inject TranslationService T
@{
    ViewData["Title"] = T.CurrentLang == "ar" ? "سجل التدقيق" : "Audit Logs";
    var isRtl = T.CurrentLang == "ar";
}

<div class="card-custom p-4 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label">@(isRtl ? "العيادة" : "Clinic")</label>
            <input name="clinicId" type="number" min="1" value="@Model.ClinicId" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">@(isRtl ? "الإجراء" : "Action")</label>
            <input name="action" value="@Model.Action" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">@(isRtl ? "بحث" : "Search")</label>
            <input name="q" value="@Model.Query" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">@(isRtl ? "الحد" : "Limit")</label>
            <input name="take" type="number" min="25" max="250" value="@Model.Take" class="form-control" />
        </div>
        <div class="col-md-1 d-grid">
            <button class="btn-primary-custom" type="submit"><i class="bi bi-filter"></i></button>
        </div>
    </form>
</div>

<div class="card-custom p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>@(isRtl ? "الوقت" : "Time")</th>
                    <th>@(isRtl ? "الإجراء" : "Action")</th>
                    <th>@(isRtl ? "الملخص" : "Summary")</th>
                    <th>@(isRtl ? "الفاعل" : "Actor")</th>
                    <th>@(isRtl ? "الهدف" : "Target")</th>
                    <th>@(isRtl ? "العيادة" : "Clinic")</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr>
                    <td class="text-nowrap"><span class="text-muted">@log.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span></td>
                    <td><code>@log.Action</code></td>
                    <td>@log.Summary</td>
                    <td>
                        <div>@(log.ActorEmail ?? "-")</div>
                        <small class="text-muted">@log.ActorRoles</small>
                    </td>
                    <td><span>@log.TargetEntityType</span><small class="text-muted d-block">@log.TargetEntityId</small></td>
                    <td>@(log.ClinicId?.ToString() ?? "-")</td>
                </tr>
            }
            @if (Model.Logs.Count == 0)
            {
                <tr><td colspan="6" class="text-center py-4 text-muted">@(isRtl ? "لا توجد سجلات" : "No audit logs found")</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
