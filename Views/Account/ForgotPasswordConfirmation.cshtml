@using MoodBite.Services
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("auth.forgotPassword");
    Layout = "_Layout";
    var isRtl = T.CurrentLang == "ar";
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-md-5 col-lg-4">
                <div class="auth-card fade-in text-center">
                    <div style="font-size:3rem;margin-bottom:16px">📧</div>
                    <h2 class="auth-title">@(isRtl ? "تم الإرسال!" : "Email Sent!")</h2>
                    <p style="color:var(--text-secondary);margin-bottom:24px">
                        @(isRtl
                            ? "إذا كان البريد الإلكتروني مسجلاً لدينا، ستتلقى رابطاً لإعادة تعيين كلمة المرور خلال دقائق."
                            : "If the email is registered with us, you'll receive a password reset link within a few minutes.")
                    </p>
                    <a asp-action="Login" class="btn-primary-custom btn-lg-custom">
                        <i class="bi bi-box-arrow-in-right"></i>
                        @T.Get("auth.login")
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
