@model MoodBite.ViewModels.Account.ResetPasswordViewModel
@using MoodBite.Services
@inject TranslationService T
@{
    Layout = "_Layout";
    var isRtl = T.CurrentLang == "ar";
    ViewData["Title"] = isRtl ? "إعادة تعيين كلمة المرور" : "Reset Password";
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-md-5 col-lg-4">
                <div class="auth-card fade-in">
                    <div class="auth-logo">
                        <div class="auth-logo-icon">🔐</div>
                        <h4 class="auth-brand">MoodBite</h4>
                    </div>
                    <h2 class="auth-title">@(isRtl ? "كلمة مرور جديدة" : "New Password")</h2>
                    <p class="auth-subtitle">@(isRtl ? "أدخل كلمة المرور الجديدة" : "Enter your new password")</p>

                    <form asp-action="ResetPassword" method="post">
                        <input asp-for="Token" type="hidden" />
                        <input asp-for="Email" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">@T.Get("auth.password")</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control" id="passwordInput" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('passwordInput', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">@T.Get("auth.confirmPassword")</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" id="confirmPasswordInput" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirmPasswordInput', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn-primary-custom w-100 btn-lg-custom">
                            <i class="bi bi-check-circle"></i>
                            @(isRtl ? "تعيين كلمة المرور" : "Reset Password")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
