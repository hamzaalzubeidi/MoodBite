@model MoodBite.ViewModels.Account.ForgotPasswordViewModel
@using MoodBite.Services
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("auth.forgotPassword");
    Layout = "_Layout";
    var isRtl = T.CurrentLang == "ar";
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-md-5 col-lg-4">
                <div class="auth-card fade-in">
                    <div class="auth-logo">
                        <div class="auth-logo-icon">🔑</div>
                        <h4 class="auth-brand">MoodBite</h4>
                    </div>
                    <h2 class="auth-title">@T.Get("auth.forgotPassword")</h2>
                    <p class="auth-subtitle">@(isRtl ? "أدخل بريدك الإلكتروني لإعادة تعيين كلمة المرور" : "Enter your email to reset your password")</p>

                    <form asp-action="ForgotPassword" method="post">
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label">@T.Get("auth.email")</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="@(isRtl ? "البريد الإلكتروني" : "Email address")" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn-primary-custom w-100 btn-lg-custom">
                            <i class="bi bi-send"></i>
                            @(isRtl ? "إرسال رابط الإعادة" : "Send Reset Link")
                        </button>
                    </form>

                    <p class="text-center mt-4 mb-0" style="color:var(--text-secondary);font-size:.9rem">
                        <a asp-action="Login" class="text-primary text-decoration-none">
                            <i class="bi bi-arrow-@(isRtl?"right":"left")"></i>
                            @(isRtl ? "العودة لتسجيل الدخول" : "Back to Login")
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
