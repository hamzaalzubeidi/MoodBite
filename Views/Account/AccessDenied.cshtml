@using MoodBite.Services
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("error.403.title");
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div style="width:78px;height:78px;border-radius:var(--radius-lg);background:var(--primary-50);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;color:var(--primary)">
        <i data-lucide="shield-alert" style="width:38px;height:38px"></i>
    </div>
    <h1 style="font-weight:800;color:var(--text-primary);margin-bottom:12px">
        @T.Get("error.403.title")
    </h1>
    <p style="color:var(--text-secondary);max-width:400px;margin:0 auto 32px">
        @T.Get("error.403.message")
    </p>
    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-primary-custom btn-lg-custom">
        <i class="bi bi-house"></i>
        @T.Get("nav.home")
    </a>
</div>
