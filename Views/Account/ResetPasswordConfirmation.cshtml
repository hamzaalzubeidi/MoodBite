@using MoodBite.Services
@inject TranslationService T
@{
    ViewData["Title"] = "Password Reset";
    Layout = "_Layout";
    var isRtl = T.CurrentLang == "ar";
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-md-5 col-lg-4">
                <div class="auth-card fade-in text-center">
                    <div style="font-size:3rem;margin-bottom:16px">✅</div>
                    <h2 class="auth-title">@(isRtl ? "تم التغيير!" : "Password Reset!")</h2>
                    <p style="color:var(--text-secondary);margin-bottom:24px">
                        @(isRtl
                            ? "تم تغيير كلمة المرور بنجاح. يمكنك الآن تسجيل الدخول."
                            : "Your password has been reset successfully. You can now log in.")
                    </p>
                    <a asp-action="Login" class="btn-primary-custom btn-lg-custom">
                        <i class="bi bi-box-arrow-in-right"></i>
                        @T.Get("auth.login")
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
