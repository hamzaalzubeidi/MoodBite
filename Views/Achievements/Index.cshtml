@model List<MoodBite.Services.AchievementViewModel>
@using MoodBite.Services
@inject TranslationService T
@{
    ViewData["Title"] = T.CurrentLang == "ar" ? "الإنجازات" : "Achievements";
    Layout = "_Layout";
    var isRtl = T.CurrentLang == "ar";
    var totalPoints    = (int)ViewBag.TotalPoints;
    var possiblePoints = (int)ViewBag.PossiblePoints;
    var unlockedCount  = (int)ViewBag.UnlockedCount;
    var totalCount     = (int)ViewBag.TotalCount;
    var category       = ViewBag.Category as string;
    var pointsPct      = possiblePoints > 0 ? (int)(totalPoints * 100.0 / possiblePoints) : 0;

    var categories = new[] {
        ("", isRtl ? "الكل" : "All"),
        ("streak",    isRtl ? "الثبات"     : "Streak"),
        ("nutrition", isRtl ? "التغذية"    : "Nutrition"),
        ("hydration", isRtl ? "الترطيب"    : "Hydration"),
        ("mood",      isRtl ? "المزاج"     : "Mood"),
        ("explorer",  isRtl ? "المستكشف"   : "Explorer"),
    };
}

@section Styles {
<style>
.achievement-card {
    position: relative;
    border-radius: var(--radius-xl);
    padding: 1.5rem 1.25rem;
    backdrop-filter: blur(12px);
    transition: transform .25s, box-shadow .25s;
    cursor: default;
    overflow: hidden;
}
.achievement-card:hover { transform: translateY(-4px) scale(1.02); }
.achievement-card.unlocked {
    background: var(--surface);
    box-shadow: 0 4px 24px rgba(0,0,0,.08);
}
.achievement-card.unlocked::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-xl);
    padding: 2px;
    background: var(--grad);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
}
.achievement-card.unlocked:hover {
    box-shadow: 0 8px 32px rgba(5,150,105,.25);
}
.achievement-card.locked {
    background: var(--surface);
    opacity: .6;
    filter: grayscale(.6);
}
.achievement-card.locked:hover { transform: translateY(-2px); }
.achievement-emoji {
    font-size: 2.4rem;
    line-height: 1;
    margin-bottom: .5rem;
    display: block;
}
.achievement-card.unlocked .achievement-emoji { filter: drop-shadow(0 2px 8px rgba(5,150,105,.4)); }
.achievement-glow {
    position: absolute;
    top: -20px; right: -20px;
    width: 80px; height: 80px;
    border-radius: 50%;
    background: var(--grad);
    opacity: .12;
    pointer-events: none;
}
.progress-bar-thin {
    height: 5px;
    border-radius: 99px;
    background: var(--border);
    overflow: hidden;
    margin-top: .5rem;
}
.progress-bar-thin-fill {
    height: 100%;
    border-radius: 99px;
    background: var(--grad-fallback, var(--primary));
    transition: width .6s ease;
}
.points-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: .7rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 99px;
    background: rgba(5,150,105,.12);
    color: var(--primary);
}
.unlocked-stamp {
    position: absolute;
    top: 10px;
    inset-inline-end: 10px;
    font-size: .65rem;
    font-weight: 700;
    background: var(--grad);
    color: white;
    padding: 2px 8px;
    border-radius: 99px;
}
.total-points-ring {
    width: 110px; height: 110px;
    position: relative;
    flex-shrink: 0;
}
</style>
}

<div class="container-xl py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 style="font-weight:800;font-size:1.6rem;margin:0">
                🏅 @(isRtl ? "الإنجازات" : "Achievements")
            </h1>
            <p class="text-muted mb-0">
                @(isRtl ? "تتبع تقدمك واكسب النقاط" : "Track your progress and earn points")
            </p>
        </div>
        <div class="card-glass p-3 d-flex align-items-center gap-4">
            <!-- Points ring -->
            <div class="total-points-ring">
                <svg viewBox="0 0 110 110" style="width:100%;height:100%;transform:rotate(-90deg)">
                    <circle cx="55" cy="55" r="46" fill="none" stroke="var(--border)" stroke-width="10"/>
                    <circle cx="55" cy="55" r="46" fill="none" stroke="#059669" stroke-width="10"
                            stroke-dasharray="@(Math.Round(2 * Math.PI * 46 * pointsPct / 100, 1)) 999"
                            stroke-linecap="round"/>
                </svg>
                <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center">
                    <div style="font-size:1.3rem;font-weight:900;color:var(--primary);line-height:1">@totalPoints</div>
                    <div style="font-size:.65rem;color:var(--text-secondary)">@(isRtl?"نقطة":"pts")</div>
                </div>
            </div>
            <div>
                <div style="font-weight:700;font-size:.9rem">@unlockedCount / @totalCount @(isRtl?"مفتوح":"unlocked")</div>
                <div style="font-size:.8rem;color:var(--text-secondary)">@totalPoints / @possiblePoints @(isRtl?"نقطة":"points")</div>
                <div class="progress-bar-thin mt-2" style="width:140px">
                    <div class="progress-bar-thin-fill" style="width:@pointsPct%;background:linear-gradient(90deg,#059669,#0d9488)"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Filter -->
    <div class="d-flex gap-2 flex-wrap mb-4">
        @foreach (var (val, label) in categories)
        {
            var isActive = (string.IsNullOrEmpty(val) && string.IsNullOrEmpty(category)) || val == category;
            <a href="@Url.Action("Index", new { category = string.IsNullOrEmpty(val) ? null : val })"
               class="badge-custom @(isActive ? "badge-primary" : "badge-neutral")"
               style="font-size:.85rem;padding:6px 14px">@label</a>
        }
    </div>

    <!-- Grid -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 card-glass p-5">
            <div style="font-size:3rem;margin-bottom:12px">🔍</div>
            <p class="text-muted">@(isRtl ? "لا توجد إنجازات في هذه الفئة" : "No achievements in this category")</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var vm in Model.OrderByDescending(v => v.IsUnlocked).ThenBy(v => v.Definition.Points))
            {
                var def = vm.Definition;
                var pct = def.RequiredCount > 0 ? (int)(vm.Progress * 100.0 / def.RequiredCount) : 0;
                <div class="col-sm-6 col-lg-4 col-xl-3 animate-on-scroll">
                    <div class="achievement-card @(vm.IsUnlocked ? "unlocked" : "locked")"
                         style="--grad:@def.Gradient;--grad-fallback:@(def.Gradient.Contains("10b981") ? "#10b981" : def.Gradient.Contains("06b6d4") ? "#06b6d4" : def.Gradient.Contains("f59e0b") ? "#f59e0b" : "#059669")">

                        @if (vm.IsUnlocked) { <div class="achievement-glow"></div> }

                        @if (vm.IsUnlocked)
                        {
                            <div class="unlocked-stamp">✓ @(isRtl ? "مفتوح" : "Unlocked")</div>
                        }

                        <span class="achievement-emoji">@def.Emoji</span>

                        <div style="font-weight:800;font-size:.95rem;margin-bottom:4px;color:var(--text-primary)">
                            @(isRtl ? def.NameAr : def.NameEn)
                        </div>
                        <div style="font-size:.78rem;color:var(--text-secondary);margin-bottom:8px">
                            @(isRtl ? def.DescAr : def.DescEn)
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-auto">
                            <span class="points-badge"><i data-lucide="zap" class="icon-amber"></i> @def.Points @(isRtl ? "نقطة" : "pts")</span>
                            @if (!vm.IsUnlocked)
                            {
                                <span style="font-size:.72rem;color:var(--text-muted)">@vm.Progress / @def.RequiredCount</span>
                            }
                            else if (vm.UnlockedAt.HasValue)
                            {
                                <span style="font-size:.68rem;color:var(--text-muted)">@vm.UnlockedAt.Value.ToString("MM/dd/yyyy")</span>
                            }
                        </div>

                        @if (!vm.IsUnlocked)
                        {
                            <div class="progress-bar-thin">
                                <div class="progress-bar-thin-fill" style="width:@pct%"></div>
                            </div>
                        }
                        else
                        {
                            <!-- Sparkle shimmer on unlocked -->
                            <div style="height:3px;border-radius:99px;margin-top:.5rem;background:@def.Gradient;opacity:.6"></div>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>

<!-- Confetti canvas (for any newly triggered from this page) -->
<canvas id="confettiCanvas" style="position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999"></canvas>
