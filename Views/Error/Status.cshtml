@model ErrorPageViewModel
@inject TranslationService T
@{
    ViewData["Title"] = Model.Title;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<section class="container py-5">
    <div class="card-glass p-5 text-center" style="border-radius:var(--radius-lg);max-width:760px;margin:0 auto">
        <div style="width:78px;height:78px;border-radius:var(--radius-lg);background:var(--primary-50);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;color:var(--primary)">
            <i data-lucide="@Model.Icon" style="width:38px;height:38px"></i>
        </div>
        <div class="badge-custom badge-neutral mb-3">@Model.StatusCode</div>
        <h1 style="font-weight:900;color:var(--text-primary);font-size:clamp(1.55rem,3vw,2.25rem);margin-bottom:12px">@Model.Title</h1>
        <p style="color:var(--text-secondary);max-width:560px;margin:0 auto 28px;line-height:1.8">
            @Model.Message
        </p>

        <div class="d-flex justify-content-center gap-2 flex-wrap">
            @if (isAuthenticated)
            {
                <a asp-area="" asp-controller="Dashboard" asp-action="Index" class="btn-primary-custom">
                    <i data-lucide="layout-dashboard"></i>@T.Get("nav.dashboard")
                </a>
            }
            else
            {
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-primary-custom">
                    <i data-lucide="home"></i>@T.Get("nav.home")
                </a>
                <a asp-area="" asp-controller="Account" asp-action="Login" class="btn-secondary-custom">
                    <i data-lucide="log-in"></i>@T.Get("nav.login")
                </a>
            }
        </div>

        @if (Model.ShowRequestId)
        {
            <div style="color:var(--text-muted);font-size:.78rem;margin-top:24px">
                @T.Get("error.requestId"): <code>@Model.RequestId</code>
            </div>
        }
    </div>
</section>
