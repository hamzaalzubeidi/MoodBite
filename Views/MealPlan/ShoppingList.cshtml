@using MoodBite.Services
@using System.Text.Json
@inject TranslationService T
@{
    ViewData["Title"] = T.Get("mealPlan.shoppingList");
    Layout = "_Layout";
    var isRtl = T.CurrentLang == "ar";
    var shopping = ViewBag.Shopping is JsonElement s ? s : (JsonElement?)null;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="d-flex align-items-center gap-3 mb-4">
                <a asp-action="Index" class="btn-ghost-custom">
                    <i class="bi bi-arrow-@(isRtl?"right":"left")"></i>
                </a>
                <div>
                    <h1 style="font-weight:800;font-size:1.6rem;margin:0">
                        <i class="bi bi-bag text-primary me-2"></i>
                        @T.Get("mealPlan.shoppingList")
                    </h1>
                    <p class="text-muted mb-0">@(isRtl?"قائمة مشترياتك الأسبوعية":"Your weekly shopping list")</p>
                </div>
            </div>

            @if (shopping.HasValue && shopping.Value.ValueKind == JsonValueKind.Object)
            {
                @foreach (var category in shopping.Value.EnumerateObject())
                {
                    var catName = category.Name switch {
                        "proteins" => isRtl ? "البروتينات" : "Proteins",
                        "vegetables" => isRtl ? "الخضروات" : "Vegetables",
                        "grains" => isRtl ? "الحبوب" : "Grains",
                        "dairy" => isRtl ? "الألبان" : "Dairy",
                        "supplements" => isRtl ? "المكملات" : "Supplements",
                        _ => category.Name
                    };
                    var catEmoji = category.Name switch {
                        "proteins"    => "<i data-lucide=\"beef\" class=\"icon-red\"></i>",
                        "vegetables"  => "<i data-lucide=\"leaf\" class=\"icon-green\"></i>",
                        "grains"      => "<i data-lucide=\"wheat\" class=\"icon-amber\"></i>",
                        "dairy"       => "<i data-lucide=\"milk\" class=\"icon-blue\"></i>",
                        "supplements" => "<i data-lucide=\"pill\" class=\"icon-purple\"></i>",
                        _             => "<i data-lucide=\"package\" class=\"icon-muted\"></i>"
                    };

                    <div class="card-glass p-4 mb-3 animate-on-scroll">
                        <h5 style="font-weight:700;margin-bottom:12px">@Html.Raw(catEmoji) @catName</h5>
                        @if (category.Value.ValueKind == JsonValueKind.Array)
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var item in category.Value.EnumerateArray())
                                {
                                    var itemName = item.ValueKind == JsonValueKind.String ? item.GetString() :
                                                   item.TryGetProperty(isRtl ? "nameAr" : "name", out var n) ? n.GetString() :
                                                   item.TryGetProperty("name", out var n2) ? n2.GetString() : item.ToString();
                                    <li class="d-flex align-items-center gap-2 mb-2">
                                        <input type="checkbox" class="form-check-input shopping-check" style="width:18px;height:18px;cursor:pointer" />
                                        <span class="shopping-item">@itemName</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 card-glass p-5">
                    <div style="font-size:3rem;margin-bottom:12px"><i data-lucide="shopping-cart" class="icon-green"></i></div>
                    <p class="text-muted">@(isRtl?"لا توجد قائمة تسوق بعد. قم بإنشاء خطة وجبات أولاً.":"No shopping list yet. Create a meal plan first.")</p>
                    <a asp-action="Index" class="btn-primary-custom mt-3">@T.Get("nav.mealPlan")</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.shopping-check').forEach(cb => {
        cb.addEventListener('change', function() {
            const label = this.nextElementSibling;
            label.style.textDecoration = this.checked ? 'line-through' : '';
            label.style.opacity = this.checked ? '0.5' : '1';
        });
    });
</script>
}
